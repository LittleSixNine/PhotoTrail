        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择字段 → 编辑并预览 → 写入所有元数据"}},
        "en": {"stringUnit": {"state": "translated", "value": "Select fields → Edit and preview → Write all metadata"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇欄位 → 編輯並預覽 → 寫入所有中繼資料"}},
        "ja": {"stringUnit": {"state": "translated", "value": "項目を選択 → 編集・プレビュー → すべてのメタデータを書き込む"}},
        "ko": {"stringUnit": {"state": "translated", "value": "필드 선택 → 편집 및 미리 보기 → 모든 메타데이터 기록"}},
        "es": {"stringUnit": {"state": "translated", "value": "Seleccionar campos → Editar y previsualizar → Escribir todos los metadatos"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Selecionar campos → Editar e visualizar → Gravar todos os metadados"}}
      }
    },
    "选择照片以应用收藏": {
