    },
    "本次已跳过 %1$@ 个不支持的文件。支持导入图片及 GPX、KML、KMZ 轨迹。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "本次已跳过 %1$@ 个不支持的文件。支持导入图片及 GPX、KML、KMZ 轨迹。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Skipped unsupported files: %1$@. Images and GPX, KML and KMZ tracks can be imported."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "本次已略過 %1$@ 個不支援的檔案。支援匯入圖片及 GPX、KML、KMZ 軌跡。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "未対応ファイル %1$@ 件をスキップしました。画像と GPX・KML・KMZ の軌跡を読み込めます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지원하지 않는 파일 %1$@개를 건너뛰었습니다. 이미지와 GPX, KML, KMZ 경로를 가져올 수 있습니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Archivos no compatibles omitidos: %1$@. Se pueden importar imágenes y recorridos GPX, KML y KMZ."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Arquivos incompatíveis ignorados: %1$@. É possível importar imagens e trajetos GPX, KML e KMZ."}}
      }
    },
