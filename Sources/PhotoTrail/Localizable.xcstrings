    "无法预览字段修改；请检查输入并重新读取元数据。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法预览字段修改；请检查输入并重新读取元数据。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cannot preview field changes; check the input and reload metadata."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法預覽欄位修改；請檢查輸入並重新讀取中繼資料。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "変更をプレビューできません。入力を確認し、メタデータを再読み込みしてください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "필드 변경을 미리 볼 수 없습니다. 입력을 확인하고 메타데이터를 다시 읽으세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pueden previsualizar los cambios; revise la entrada y vuelva a leer los metadatos."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível visualizar as alterações; confira a entrada e releia os metadados."}}
      }
    },
    "字段修改待保存": {
