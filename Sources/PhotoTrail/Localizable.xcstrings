    "搜索包含全部字段；保留你设置的隐藏与值筛选。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "搜索包含全部字段；保留你设置的隐藏与值筛选。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Search covers all fields while respecting hidden fields and value filters."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "搜尋包含全部欄位；保留你設定的隱藏與值篩選。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "検索対象は全フィールドです。非表示設定と値のフィルタは維持されます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "모든 필드를 검색하며 숨김 설정과 값 필터는 유지합니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "La búsqueda abarca todos los campos y respeta los campos ocultos y los filtros de valores."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A busca abrange todos os campos e respeita os campos ocultos e os filtros de valores."}}
      }
    },
