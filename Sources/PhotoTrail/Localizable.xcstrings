        "ko": {"stringUnit": {"state": "translated", "value": "메타데이터 쓰기 결과가 확인되지 않았습니다. 바로 재시도하지 말고 디스크 파일을 확인하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Resultado sin confirmar; revise el archivo en disco antes de crear otro borrador."}},
