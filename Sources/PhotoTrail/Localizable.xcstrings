    "导入本地照片或添加文件后设置规则，先核对预览，再执行改名。照片图库项目不支持文件改名。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入本地照片或添加文件后设置规则，先核对预览，再执行改名。照片图库项目不支持文件改名。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import local photos or add files, then set rules and check the preview before renaming. Photo library items cannot be renamed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入本機照片或加入檔案後設定規則，先核對預覽，再執行重新命名。照片圖庫項目不支援檔案重新命名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル写真を読み込むかファイルを追加してルールを設定し、プレビューを確認してから名前を変更します。写真ライブラリの項目は名前を変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 사진을 가져오거나 파일을 추가한 뒤 규칙을 설정하고 미리보기를 확인한 후 이름을 변경하세요. 사진 보관함 항목은 이름을 변경할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa fotos locales o añade archivos, configura las reglas y revisa la vista previa antes de renombrar. Los elementos de la fototeca no se pueden renombrar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe fotos locais ou adicione arquivos, configure as regras e confira a prévia antes de renomear. Itens da fototeca não podem ser renomeados."
          }
        }
      }
    },
    "请授权文件所在目录后重新预览，才能扫描配对文件并检查重名。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请授权文件所在目录后重新预览，才能扫描配对文件并检查重名。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorize the containing folders and refresh the preview to scan paired files and check name conflicts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請授權檔案所在目錄後重新預覽，才能掃描配對檔案並檢查重名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアファイルの検索と名前の競合確認のため、親フォルダを許可してプレビューを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 파일 검색과 이름 충돌 확인을 위해 상위 폴더를 허용하고 미리보기를 갱신하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriza las carpetas contenedoras y actualiza la vista previa para buscar archivos asociados y comprobar conflictos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorize as pastas dos arquivos e atualize a prévia para buscar arquivos associados e verificar conflitos."
          }
        }
      }
    },
    "授权文件目录…": {
