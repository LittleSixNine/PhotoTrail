{
  "sourceLanguage": "en",
  "strings": {
    "请自定义文字": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请自定义文字"}}, "en": {"stringUnit": {"state": "translated", "value": "Enter custom text"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請自訂文字"}}, "ja": {"stringUnit": {"state": "translated", "value": "任意の文字を入力"}}, "ko": {"stringUnit": {"state": "translated", "value": "사용자 지정 문구 입력"}}, "es": {"stringUnit": {"state": "translated", "value": "Introduce tu texto"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Digite seu texto"}}}},
    "示例：%1$@": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "示例：%1$@"}}, "en": {"stringUnit": {"state": "translated", "value": "Example: %1$@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "範例：%1$@"}}, "ja": {"stringUnit": {"state": "translated", "value": "例：%1$@"}}, "ko": {"stringUnit": {"state": "translated", "value": "예시: %1$@"}}, "es": {"stringUnit": {"state": "translated", "value": "Ejemplo: %1$@"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Exemplo: %1$@"}}}},
    "照片：%1$@；关联文件一并列入右侧预览。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Photos: %1$@; associated files are included in the preview on the right."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "照片：%1$@；關聯檔案一併列入右側預覽。"}}, "ja": {"stringUnit": {"state": "translated", "value": "写真：%1$@。関連ファイルも右側のプレビューに含まれます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "사진: %1$@장. 연결된 파일도 오른쪽 미리보기에 포함됩니다."}}, "es": {"stringUnit": {"state": "translated", "value": "Fotos: %1$@; los archivos asociados se incluyen en la vista previa de la derecha."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Fotos: %1$@; arquivos associados são incluídos na prévia à direita."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "照片：%1$@；关联文件一并列入右侧预览。"}}}},
    "其中 %1$@ 张不是本地文件，无法直接重命名。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%1$@ photos are not local files and cannot be renamed directly."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "其中 %1$@ 張不是本機檔案，無法直接重新命名。"}}, "ja": {"stringUnit": {"state": "translated", "value": "%1$@ 枚はローカルファイルではないため、直接名前を変更できません。"}}, "ko": {"stringUnit": {"state": "translated", "value": "%1$@장의 사진은 로컬 파일이 아니므로 이름을 직접 변경할 수 없습니다."}}, "es": {"stringUnit": {"state": "translated", "value": "%1$@ fotos no son archivos locales y no se pueden renombrar directamente."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "%1$@ fotos não são arquivos locais e não podem ser renomeadas diretamente."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "其中 %1$@ 张不是本地文件，无法直接重命名。"}}}},
    "拖动以调整规则顺序": {
      "extractionState": "manual",
      "localizations": {
