    "Look at the toolbar of ContentView\nto see how these sub-views are used.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the toolbar of ContentView\nto see how these sub-views are used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看ContentView的工具栏\n看看这些子视图是如何使用的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看ContentView的工具欄\n看看這些子視圖是如何使用的。"
          }
        },
        "ja": {
