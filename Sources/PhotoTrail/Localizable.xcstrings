    "仅为没有定位的照片匹配位置，不覆盖已有定位。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match only photos without a location. Existing locations are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为没有定位的照片匹配位置，不覆盖已有定位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅為沒有定位的照片匹配位置，不覆蓋已有定位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置のない写真のみ照合します。既存の位置は保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치가 없는 사진만 일치시킵니다. 기존 위치는 유지합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se cruzan fotos sin ubicación. Se conservan las ubicaciones existentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara apenas fotos sem localização. As localizações existentes são preservadas."
          }
        }
      }
    },
    "仅大于此间隔时开始新轨迹段。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new track segment only when it is greater than this interval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅大于此间隔时开始新轨迹段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅大於此間隔時開始新軌跡段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この間隔を超えた場合にのみ、新しい軌跡区間を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 간격을 초과할 때만 새 경로 구간을 시작합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se inicia un segmento nuevo al superar este intervalo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo segmento só começa ao exceder este intervalo."
          }
        }
      }
    },
    "仅控制当前位置的地区名称查询。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only controls region-name lookup for the current location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅控制当前位置的地区名称查询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅控制當前位置的地區名稱查詢。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の位置の地域名取得方法だけを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치의 지역 이름 조회 방식만 제어합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo controla la consulta del nombre de la región actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla apenas a consulta do nome da região atual."
          }
        }
      }
    },
    "仅提醒，删除前仍会再次确认。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a reminder, it will be confirmed again before deletion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅提醒，删除前仍会再次确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅提醒，刪除前仍會再次確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知のみです。削除前に確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
