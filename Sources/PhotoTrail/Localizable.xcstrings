    "打开地图或点击定位按钮时获取本机位置，用于移动地图，不修改照片": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your device location to center the map when it opens or when you click the location button. This does not change your photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开地图或点击定位按钮时获取本机位置，用于移动地图，不修改照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開地圖或點擊定位按鈕時獲取本機位置，用於移動地圖，不修改照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図を開いたときや現在地ボタンを押したときに、デバイスの位置を地図の中心に表示します。写真は変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도를 열거나 위치 버튼을 누를 때 기기 위치로 지도를 이동합니다. 사진은 변경하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la ubicación del dispositivo para centrar el mapa al abrirlo o pulsar el botón de ubicación. No modifica las fotos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a localização do dispositivo para centralizar o mapa ao abri-lo ou clicar no botão de localização. Não altera as fotos."
          }
        }
      }
    },
