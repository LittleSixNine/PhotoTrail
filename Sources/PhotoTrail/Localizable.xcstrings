        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하여 선택, ⌘ 클릭으로 다중 선택, Shift 클릭으로 범위 선택. 더블 클릭하거나 화살표를 눌러 편집합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para seleccionar, ⌘-clic para selección múltiple y Mayús-clic para un intervalo; haz doble clic o usa la flecha para editar."
          }
        },
        "pt-BR": {
