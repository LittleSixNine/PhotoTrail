    "仅用于下次新会话；当前批次仍可单独调整。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only used for the next new session; the current batch can still be adjusted individually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于下次新会话；当前批次仍可单独调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於下次新會話；當前批次仍可單獨調整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の新規セッションにのみ適用されます。現在の写真群には別途設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 새 세션에만 적용됩니다. 현재 사진 묶음은 별도로 조정할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica a nuevas sesiones. Puedes ajustar el lote actual por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se apenas a novas sessões. Você pode ajustar o lote atual separadamente."
          }
        }
      }
    },
