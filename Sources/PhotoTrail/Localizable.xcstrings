    "缓存保存失败，本次仍可查看；下次启动可能需要重新转换。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache saving failed, it can still be viewed this time; it may need to be converted again next time it is started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存保存失败，本次仍可查看；下次启动可能需要重新转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快取保存失敗，本次仍可查看；下次啓動可能需要重新轉換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを保存できませんでした。今回は表示できますが、次回起動時に再変換が必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시 저장에 실패했습니다. 이번에는 볼 수 있지만 다음 실행 시 다시 변환해야 할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la caché. Puedes verla ahora, pero quizá debas convertirla de nuevo al reiniciar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o cache. Você pode visualizar agora, mas talvez seja necessário converter novamente ao reiniciar."
          }
        }
      }
    },
