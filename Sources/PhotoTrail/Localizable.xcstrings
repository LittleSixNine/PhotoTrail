{
  "sourceLanguage": "en",
  "strings": {
    "\n本地照片另会尝试创建 XMP 附属文件。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nPhotoTrail will also try to create XMP sidecar files for local photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n本地照片另会尝试创建 XMP 附属文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n本地照片另會嘗試創建 XMP 附屬檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\nローカル写真のXMPサイドカーファイルの作成も試みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n로컬 사진의 XMP 사이드카 파일 생성도 시도합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nTambién se intentará crear archivos auxiliares XMP para las fotos locales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\nTambém será tentada a criação de arquivos auxiliares XMP para as fotos locais."
          }
        }
      }
    },
