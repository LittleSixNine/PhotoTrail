        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either no tracks could be found or the GPX file was corrupted such that it could not be properly processed. Any track log information in the file has been ignored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件没有轨迹，或已损坏而无法读取。该文件的轨迹信息未加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案沒有軌跡，或已損壞而無法讀取。該檔案的軌跡資訊未加載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡が見つからないかGPXファイルが破損しているため、軌跡情報を読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로가 없거나 GPX 파일이 손상되어 경로 정보를 읽지 못했습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron rutas o el GPX está dañado. Se ha omitido su información de rutas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram encontradas trilhas ou o GPX está corrompido. Suas informações de trilha foram ignoradas."
          }
        }
      }
    },
