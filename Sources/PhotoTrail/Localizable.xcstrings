        "pt-BR": {"stringUnit": {"state": "translated", "value": "Somente nome comercial"}}
      }
    },
    "商品名已核实，元数据型号尚未核实；仅填入商品名。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "商品名已核实，元数据型号尚未核实；仅填入商品名。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Product name verified; metadata model unverified. Only the product name will be entered."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "商品名已核實，中繼資料型號尚未核實；僅填入商品名。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "製品名は確認済みですが、メタデータのモデル名は未確認です。製品名のみ入力します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "제품명은 확인되었지만 메타데이터 모델은 미확인입니다. 제품명만 입력됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Nombre comercial verificado; modelo de metadatos sin verificar. Solo se introducirá el nombre."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Nome comercial verificado; modelo de metadados não verificado. Apenas o nome será inserido."}}
      }
    },
    "同一行对应同一设备；“仅商品名”表示尚未核实元数据型号。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "同一行对应同一设备；“仅商品名”表示尚未核实元数据型号。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Each row is one device. “Product name only” means its metadata model is unverified."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "同一列對應同一裝置；「僅商品名」表示尚未核實中繼資料型號。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "同じ行は同じ機器です。「製品名のみ」はメタデータのモデル名が未確認であることを示します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "각 행은 같은 기기입니다. ‘제품명만’은 메타데이터 모델이 미확인임을 뜻합니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada fila es un dispositivo. «Solo nombre comercial» indica que su modelo de metadatos no está verificado."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada linha é um dispositivo. “Somente nome comercial” indica que o modelo de metadados não foi verificado."}}
      }
    },
