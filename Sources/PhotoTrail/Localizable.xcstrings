    "The above GPX file(s) have been processed and will show as tracks on the map.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The above GPX file(s) have been processed and will show as tracks on the map."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以上 GPX 文件已处理，可在苹果地图上显示轨迹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以上 GPX 檔案已處理，可在蘋果地圖上顯示軌跡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上記のGPXファイルを読み込みました。地図に軌跡が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 GPX 파일을 처리했으며 지도에 경로로 표시됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos GPX indicados se han procesado y aparecerán como rutas en el mapa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos GPX indicados foram processados e aparecerão como trilhas no mapa."
          }
        }
      }
    },
    "This tag will be added to files when Tag updated files is checked. If the tag is empty \"PhotoTrail\" will be used.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tag will be added to files when Tag updated files is checked. If the tag is empty \"PhotoTrail\" will be used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启文件标签后使用此名称，留空时使用“PhotoTrail”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啓檔案標籤後使用此名稱，留空時使用“PhotoTrail”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「更新したファイルにタグを付ける」がオンの場合、このタグを使います。空欄の場合は「PhotoTrail」を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 태그 추가가 켜져 있으면 이 태그를 사용합니다. 비어 있으면 PhotoTrail을 사용합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta se usa cuando está activado el etiquetado de archivos. Si está vacía, se usa «PhotoTrail»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta é usada quando a opção de etiquetar arquivos está ativada. Se estiver vazia, será usado “PhotoTrail”."
          }
        }
      }
    },
