    },
    "新的信息将写入文件，包括照片信息与定位修改，不限当前选中的照片。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "新的信息将写入文件，包括照片信息与定位修改，不限当前选中的照片。"}},
        "en": {"stringUnit": {"state": "translated", "value": "The new information will be written to the files, including photo information and location changes, not just for the currently selected photos."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "新的資訊將寫入檔案，包括照片資訊與定位修改，不限目前選取的照片。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "写真情報と位置情報の変更を含む新しい情報をファイルに書き込みます。現在選択している写真だけが対象ではありません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "사진 정보와 위치 변경 사항을 포함한 새 정보를 파일에 기록합니다. 현재 선택한 사진에만 적용되는 것은 아닙니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "La información nueva se escribirá en los archivos, incluidos los cambios de información de las fotos y ubicación, no solo en las fotos seleccionadas."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "As novas informações serão gravadas nos arquivos, incluindo alterações nas informações das fotos e na localização, não apenas nas fotos selecionadas."}}
      }
    },
    "无法读取原轨迹，请重新导入；已有缓存保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取原轨迹，请重新导入；已有缓存保留。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cannot read the original track. Import it again; the existing cache is kept."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法讀取原軌跡，請重新匯入；已有快取保留。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "元の軌跡を読み込めません。再度読み込んでください。既存のキャッシュは保持されます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "원본 경로를 읽을 수 없습니다. 다시 가져오세요. 기존 캐시는 유지됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se puede leer el recorrido original. Impórtalo de nuevo; se conserva la caché existente."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível ler o trajeto original. Importe novamente; o cache existente será mantido."}}
      }
    },
    "更多匹配选项": {
