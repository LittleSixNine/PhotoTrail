    "轨迹使用原始坐标，无需转换；缓存仅存本机。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The track uses original coordinates without conversion; the cache only saves the local machine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轨迹使用原始坐标，无需转换；缓存仅存本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "軌跡使用原始坐標，無需轉換；快取僅存本機。"
