    "单击选择，⌘ 点选多项，Shift 连选；双击或点箭头编辑。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to select, ⌘-click to select multiple, Shift-click for a range; double-click or use the arrow to edit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击选择，⌘ 点选多项，Shift 连选；双击或点箭头编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下選取，⌘ 點選多項，Shift 連選；按兩下或點箭頭編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックで選択、⌘＋クリックで複数選択、Shift＋クリックで範囲選択。ダブルクリックまたは矢印で編集。"
          }
