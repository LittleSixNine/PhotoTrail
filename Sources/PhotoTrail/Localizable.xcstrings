          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高德地图加载失败，请检查 Key、安全密钥和网络后重新加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
