        "en": {"stringUnit": {"state": "translated", "value": "Select photos to view their locations"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇照片以查看定位"}},
        "ja": {"stringUnit": {"state": "translated", "value": "写真を選択して位置を確認"}},
        "ko": {"stringUnit": {"state": "translated", "value": "사진을 선택하여 위치 보기"}},
        "es": {"stringUnit": {"state": "translated", "value": "Selecciona fotos para ver su ubicación"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Selecione fotos para ver a localização"}}
