    "所选位置校验失败，未修改照片。请检查网络、凭据或服务配额。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected location verification failed and the photo has not been modified. Please check network, credentials, or service quotas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选位置校验失败，未修改照片。请检查网络、凭据或服务配额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選位置校驗失敗，未修改照片。請檢查網絡、憑據或服務配額。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置の検証に失敗しました。写真は変更していません。ネットワーク、認証情報、サービスの利用枠を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 검증 실패. 사진은 변경되지 않았습니다. 네트워크, 인증 정보, 서비스 할당량을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la ubicación. La foto no cambió. Comprueba la red, las credenciales y la cuota del servicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a localização. A foto não mudou. Confira a rede, as credenciais e a cota do serviço."
          }
        }
      }
    },
