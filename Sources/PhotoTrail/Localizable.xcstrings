    "Latitude and Longitude updates will not take effect until the *return* key is pressed when either field is active.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latitude and Longitude updates will not take effect until the *return* key is pressed when either field is active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改纬度或经度后，按回车键才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改緯度或經度後，按回車鍵才會生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緯度・経度は、いずれかの入力欄でReturnキーを押すと反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위도·경도는 입력란에서 Return 키를 눌러야 적용됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de latitud y longitud se aplican al pulsar Retorno en uno de los campos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações de latitude e longitude são aplicadas ao pressionar Return em um dos campos."
          }
        }
      }
