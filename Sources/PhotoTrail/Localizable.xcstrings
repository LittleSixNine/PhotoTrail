    "正数增加，负数减少；分别以每张照片的当前字段值计算。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive values add; negative values subtract. Each photo uses its current field value."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正数增加，负数减少；分别以每张照片的当前字段值计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正數增加，負數減少；分別以每張照片的目前欄位值計算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値で加算、負の値で減算します。各写真の現在のフィールド値を基準に計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양수는 더하고 음수는 뺍니다. 각 사진의 현재 필드 값을 기준으로 계산합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores positivos suman y los negativos restan. Se usa el valor actual del campo de cada foto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores positivos somam; negativos subtraem. O cálculo usa o valor atual do campo de cada foto."
          }
        }
      }
    },
    "按年→月→日→时→分→秒计算；无效日期不会自动改成月末。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied in year → month → day → hour → minute → second order. Invalid dates are rejected instead of clamped to month-end."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按年→月→日→时→分→秒计算；无效日期不会自动改成月末。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按年→月→日→時→分→秒計算；無效日期不會自動改成月底。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年→月→日→時→分→秒の順で計算します。無効な日付を自動的に月末へ補正しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "년→월→일→시→분→초 순서로 계산합니다. 유효하지 않은 날짜를 월말로 자동 조정하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica en orden: año → mes → día → hora → minuto → segundo. Las fechas inválidas se rechazan, sin ajustarlas al fin de mes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado na ordem ano → mês → dia → hora → minuto → segundo. Datas inválidas são rejeitadas, sem ajuste para o fim do mês."
          }
        }
      }
    }
,
    "作者保存：成功 %1$@ 张，待处理 %2$@ 张。": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Creator save: %1$@ succeeded, %2$@ need attention." } },
