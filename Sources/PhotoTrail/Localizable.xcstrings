      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅供查看：缺少轨迹点时间"}},
        "en": {"stringUnit": {"state": "translated", "value": "View only: track points have no timestamps"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅供檢視：缺少軌跡點時間"}},
        "ja": {"stringUnit": {"state": "translated", "value": "表示のみ：軌跡点の時刻がありません"}},
        "ko": {"stringUnit": {"state": "translated", "value": "보기 전용: 경로 지점에 시간 정보 없음"}},
        "es": {"stringUnit": {"state": "translated", "value": "Solo visualización: los puntos no tienen hora"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Apenas visualização: pontos sem horário"}}
      }
    },
    "仅控制地图显示，不改变匹配范围。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅控制地图显示，不改变匹配范围。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Only controls map visibility; the matching scope stays the same."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅控制地圖顯示，不改變比對範圍。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "地図上の表示のみを変更し、照合範囲は変わりません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지도 표시만 제어하며 매칭 범위는 바뀌지 않습니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Solo controla la visibilidad en el mapa; no cambia el alcance de asociación."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Controla apenas a exibição no mapa; o escopo da associação não muda."}}
      }
    },
    "仍有未保存修改，未执行重命名。请检查保存结果后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "仍有未保存修改，未执行重命名。请检查保存结果后重试。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Some changes remain unsaved. No files were renamed. Check the save results and try again."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "仍有未儲存修改，未執行重新命名。請檢查儲存結果後重試。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "未保存の変更があるため、名前は変更していません。保存結果を確認して再試行してください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "저장하지 못한 변경 사항이 있어 이름을 변경하지 않았습니다. 저장 결과를 확인한 뒤 다시 시도하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Quedan cambios sin guardar. No se ha renombrado ningún archivo. Revisa el resultado e inténtalo de nuevo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ainda há alterações não salvas. Nenhum arquivo foi renomeado. Confira o resultado e tente novamente."}}
