    "部分 GPX 文件未能导入，请在轨迹卡片中查看。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some GPX files failed to import, please check in the track card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分 GPX 文件未能导入，请在轨迹卡片中查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分 GPX 檔案未能導入，請在軌跡卡片中查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のGPXを読み込めませんでした。軌跡カードを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
