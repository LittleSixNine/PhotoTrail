          "stringUnit": {
            "state": "translated",
            "value": "部分照片位置顯示失敗；原照片數據未改變。請檢查網絡或服務配額。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の写真の位置を表示できません。元の写真データは変わっていません。ネットワークやサービスの利用枠を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 사진 위치를 표시하지 못했습니다. 원본 사진 데이터는 변경되지 않았습니다. 네트워크 또는 서비스 할당량을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron mostrar algunas ubicaciones. Los datos originales no cambiaron. Comprueba la red o la cuota del servicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas localizações não puderam ser exibidas. Os dados originais não mudaram. Verifique a rede ou a cota do serviço."
          }
        }
      }
    },
