          "stringUnit": {
            "state": "translated",
            "value": "같은 촬영 시간에 여러 위치가 있습니다. 사용할 경로를 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma hora corresponde a varias ubicaciones. Selecciona la ruta que deseas usar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo horário corresponde a várias localizações. Selecione a trilha a usar."
