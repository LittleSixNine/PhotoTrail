          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É apenas um aviso; haverá confirmação antes de excluir."
          }
        }
      }
    },
    "仅支持本地照片文件。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only supports local photo files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持本地照片文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅支持本地照片檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの写真ファイルのみ対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 사진 파일만 지원합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
