          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AMapを読み込めません。Key、セキュリティキー、ネットワークを確認して再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
