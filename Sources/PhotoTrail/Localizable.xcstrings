          "stringUnit": {
            "state": "translated",
            "value": "Compara apenas fotos sem localização. As localizações existentes são preservadas."
          }
        }
      }
    },
    "仅大于此间隔时开始新轨迹段。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new track segment only when it is greater than this interval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅大于此间隔时开始新轨迹段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅大於此間隔時開始新軌跡段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この間隔を超えた場合にのみ、新しい軌跡区間を開始します。"
