    "哈尔滨之旅": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "哈尔滨之旅"}}, "en": {"stringUnit": {"state": "translated", "value": "Harbin trip"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "哈爾濱之旅"}}, "ja": {"stringUnit": {"state": "translated", "value": "ハルビン旅行"}}, "ko": {"stringUnit": {"state": "translated", "value": "하얼빈 여행"}}, "es": {"stringUnit": {"state": "translated", "value": "Viaje a Harbin"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Viagem a Harbin"}}}},
    "同时保存两个页面的元数据？": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "同时保存两个页面的元数据？"}}, "en": {"stringUnit": {"state": "translated", "value": "Save metadata from both pages?"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "同時儲存兩個頁面的中繼資料？"}}, "ja": {"stringUnit": {"state": "translated", "value": "両方のページのメタデータを保存しますか？"}}, "ko": {"stringUnit": {"state": "translated", "value": "두 페이지의 메타데이터를 저장할까요?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Guardar los metadatos de ambas páginas?"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Salvar os metadados das duas páginas?"}}}},
    "保存当前页的元数据？": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "保存当前页的元数据？"}}, "en": {"stringUnit": {"state": "translated", "value": "Save metadata from this page?"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "儲存目前頁面的中繼資料？"}}, "ja": {"stringUnit": {"state": "translated", "value": "このページのメタデータを保存しますか？"}}, "ko": {"stringUnit": {"state": "translated", "value": "현재 페이지의 메타데이터를 저장할까요?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Guardar los metadatos de esta página?"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Salvar os metadados desta página?"}}}},
    "只保存当前页的待保存修改，其他页修改保留。": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "只保存当前页的待保存修改，其他页修改保留。"}}, "en": {"stringUnit": {"state": "translated", "value": "Save only pending changes from this page. Changes on the other page remain pending."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "只儲存目前頁面的待儲存修改，其他頁修改保留。"}}, "ja": {"stringUnit": {"state": "translated", "value": "このページの変更のみ保存し、他のページの変更は保留します。"}}, "ko": {"stringUnit": {"state": "translated", "value": "현재 페이지의 변경만 저장하고 다른 페이지의 변경은 유지합니다."}}, "es": {"stringUnit": {"state": "translated", "value": "Guarda solo los cambios de esta página; los de la otra quedan pendientes."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Salve apenas as alterações desta página; as da outra ficam pendentes."}}}},
    "下次不再提示": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "下次不再提示"}}, "en": {"stringUnit": {"state": "translated", "value": "Do not ask again"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "下次不再提示"}}, "ja": {"stringUnit": {"state": "translated", "value": "次回から表示しない"}}, "ko": {"stringUnit": {"state": "translated", "value": "다시 묻지 않기"}}, "es": {"stringUnit": {"state": "translated", "value": "No volver a preguntar"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Não perguntar novamente"}}}},
    "改为仅保存本页": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "改为仅保存本页"}}, "en": {"stringUnit": {"state": "translated", "value": "Save only this page instead"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "改為僅儲存本頁"}}, "ja": {"stringUnit": {"state": "translated", "value": "このページのみ保存に切り替える"}}, "ko": {"stringUnit": {"state": "translated", "value": "이 페이지만 저장하도록 변경"}}, "es": {"stringUnit": {"state": "translated", "value": "Guardar solo esta página"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Salvar apenas esta página"}}}},
    "保存按钮范围": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "保存按钮范围"}}, "en": {"stringUnit": {"state": "translated", "value": "Save button scope"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "儲存按鈕範圍"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存ボタンの対象"}}, "ko": {"stringUnit": {"state": "translated", "value": "저장 버튼 범위"}}, "es": {"stringUnit": {"state": "translated", "value": "Alcance del botón de guardar"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Escopo do botão de salvar"}}}},
