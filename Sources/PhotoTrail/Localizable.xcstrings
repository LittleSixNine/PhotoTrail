    "更多工具": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "更多工具"}},
        "en": {"stringUnit": {"state": "translated", "value": "More tools"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "更多工具"}},
        "ja": {"stringUnit": {"state": "translated", "value": "その他のツール"}},
