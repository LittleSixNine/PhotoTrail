        "zh-Hans": {"stringUnit": {"state": "translated", "value": "点击“预览”检查每张照片的修改结果。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Click Preview to check the result for each photo."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "按一下「預覽」檢查每張照片的修改結果。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "「プレビュー」で各写真の変更結果を確認します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "미리보기를 눌러 각 사진의 변경 결과를 확인하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Pulsa Vista previa para comprobar el resultado de cada foto."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Clique em Prévia para conferir o resultado de cada foto."}}
      }
    },
    "选择字段 → 编辑并预览 → 保存照片": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择字段 → 编辑并预览 → 保存照片"}},
        "en": {"stringUnit": {"state": "translated", "value": "Select fields → Edit and preview → Save photos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "選取欄位 → 編輯並預覽 → 儲存照片"}},
        "ja": {"stringUnit": {"state": "translated", "value": "項目を選択 → 編集とプレビュー → 写真を保存"}},
        "ko": {"stringUnit": {"state": "translated", "value": "필드 선택 → 편집 및 미리보기 → 사진 저장"}},
        "es": {"stringUnit": {"state": "translated", "value": "Elegir campos → Editar y revisar → Guardar fotos"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Selecionar campos → Editar e revisar → Salvar fotos"}}
      }
    },
    "单击选择，⌘ / Shift 多选；双击或点铅笔编辑。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "单击选择，⌘ / Shift 多选；双击或点铅笔编辑。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Click to select, ⌘ / Shift for multiple fields; double-click or use the pencil to edit."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "按一下選取，⌘ / Shift 多選；按兩下或點鉛筆編輯。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クリックで選択、⌘ / Shift で複数選択。ダブルクリックか鉛筆で編集。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "클릭하여 선택, ⌘ / Shift로 다중 선택. 두 번 클릭하거나 연필로 편집하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Clic para seleccionar, ⌘ / Shift para varios; doble clic o lápiz para editar."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Clique para selecionar, ⌘ / Shift para vários; clique duas vezes ou use o lápis para editar."}}
      }
    },
    "预览清除结果，再加入待保存修改。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "预览清除结果，再加入待保存修改。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Preview the removal, then stage the changes."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "預覽清除結果，再加入待儲存修改。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "削除結果をプレビューしてから変更を保留します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지우기 결과를 미리 본 후 변경을 준비하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Revisa el borrado y después prepara los cambios."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Confira a remoção e depois prepare as alterações."}}
      }
    },
    "点击商品名称或元数据型号，填入对应名称；名称相同时只显示一项。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "点击商品名称或元数据型号，填入对应名称；名称相同时只显示一项。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Click either the product name or metadata model to fill it in. Identical names appear once."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "點選商品名稱或中繼資料型號，填入對應名稱；名稱相同時只顯示一項。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "製品名かメタデータのモデル名をクリックして入力します。同じ名前は1つだけ表示します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "제품명 또는 메타데이터 모델을 눌러 입력합니다. 같은 이름은 한 번만 표시됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Pulsa el nombre comercial o el modelo para rellenarlo. Los nombres iguales aparecen una sola vez."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Clique no nome comercial ou no modelo para preenchê-lo. Nomes iguais aparecem uma única vez."}}
      }
    },
    "选择机型可填入样本中的制造商名称，只修改当前字段。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择机型可填入样本中的制造商名称，只修改当前字段。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Choose a device to fill its sample maker name. Only this field changes."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇機型可填入樣本中的製造商名稱，只修改目前欄位。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "機種を選ぶとサンプルのメーカー名を入力します。この項目だけを変更します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "기기를 선택하면 샘플의 제조사 이름이 입력됩니다. 이 필드만 변경됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Elige un dispositivo para usar el fabricante de la muestra. Solo cambia este campo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolha um dispositivo para usar o fabricante da amostra. Apenas este campo muda."}}
      }
    },
    "同一行对应同一设备；下方输入框仍可自由修改。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "同一行对应同一设备；下方输入框仍可自由修改。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Each row is one device. You can still edit the value in the text field."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "同一列對應同一裝置；下方輸入框仍可自由修改。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "同じ行は同じ機器です。入力欄の値は自由に編集できます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "각 행은 같은 기기입니다. 입력란의 값은 자유롭게 수정할 수 있습니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada fila corresponde a un dispositivo. Puedes editar el valor en el cuadro de texto."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada linha corresponde a um dispositivo. Você pode editar o valor no campo de texto."}}
      }
    },
    "可在预设名称上修改，也可直接输入自定义名称。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "可在预设名称上修改，也可直接输入自定义名称。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Edit a preset name or type your own."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "可在預設名稱上修改，也可直接輸入自訂名稱。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "プリセット名を編集するか、独自の名前を入力できます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "프리셋 이름을 수정하거나 직접 이름을 입력하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Modifica un nombre predefinido o escribe uno propio."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Edite um nome predefinido ou digite o seu."}}
      }
    },
    "可直接编辑完整时间，保留所需的秒、亚秒和时区。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "可直接编辑完整时间，保留所需的秒、亚秒和时区。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Edit the full timestamp to retain seconds, subseconds and time zone."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "可直接編輯完整時間，保留所需的秒、次秒和時區。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "秒、秒未満、タイムゾーンを含む時刻を直接編集できます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "초, 소수 초, 시간대를 포함한 전체 시간을 직접 편집할 수 있습니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Edita la fecha completa para conservar segundos, fracciones y zona horaria."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Edite a data completa para manter segundos, frações e fuso horário."}}
      }
    },
    "使用三个英文字母的国家代码，例如 CHN。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用三个英文字母的国家代码，例如 CHN。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Use a three-letter country code, such as CHN."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用三個英文字母的國家代碼，例如 CHN。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "CHN など3文字の国コードを入力します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "CHN과 같은 세 자리 영문 국가 코드를 입력하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Usa un código de país de tres letras, como CHN."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Use um código de país com três letras, como CHN."}}
      }
    },
    "输入 EXIF 闪光灯状态代码（0–127），例如 0 表示未闪光。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入 EXIF 闪光灯状态代码（0–127），例如 0 表示未闪光。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enter an EXIF flash status code (0–127); 0 means no flash."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入 EXIF 閃光燈狀態代碼（0–127），例如 0 表示未閃光。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "EXIF フラッシュ状態コード（0–127）を入力します。0 は発光なしです。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "EXIF 플래시 상태 코드(0–127)를 입력하세요. 0은 발광하지 않음을 뜻합니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Introduce el código EXIF del flash (0–127); 0 significa sin flash."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Insira o código EXIF do flash (0–127); 0 significa sem flash."}}
      }
    },
    "输入数值或分数，例如 1/125；单位显示在右侧。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入数值或分数，例如 1/125；单位显示在右侧。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enter a number or fraction, such as 1/125. The unit is shown on the right."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入數值或分數，例如 1/125；單位顯示在右側。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "1/125 などの数値や分数を入力します。単位は右側に表示します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "1/125와 같은 숫자나 분수를 입력하세요. 단위는 오른쪽에 표시됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Introduce un número o fracción, como 1/125. La unidad aparece a la derecha."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Insira um número ou fração, como 1/125. A unidade aparece à direita."}}
      }
    },
    "只修改此字段；其他来源中的同名字段保持原值。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "只修改此字段；其他来源中的同名字段保持原值。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Only this field changes; fields from other sources keep their values."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "只修改此欄位；其他來源中的同名欄位保留原值。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "この項目だけを変更します。他のソースの同名項目は元の値を保ちます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 필드만 변경합니다. 다른 출처의 같은 이름 필드는 유지됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Solo cambia este campo; los de otras fuentes conservan sus valores."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Apenas este campo muda; os de outras fontes mantêm seus valores."}}
      }
    },
