    "仅清除高德坐标转换结果，保留原轨迹文件和历史记录。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清除高德坐标转换结果，保留原轨迹文件和历史记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears only AMap coordinate conversions. Original track files and history are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅清除高德座標轉換結果，保留原軌跡檔案和歷史記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高徳の座標変換結果のみを消去します。元の軌跡ファイルと履歴は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가오더 좌표 변환 결과만 지웁니다. 원본 트랙 파일과 기록은 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo borra conversiones de coordenadas de AMap. Conserva los archivos originales y el historial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa apenas as conversões de coordenadas do AMap. Preserva os arquivos originais e o histórico."
          }
        }
      }
    },
    "原轨迹文件和历史记录会保留；高德轨迹在重新显示或刷新时需要再次转换。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原轨迹文件和历史记录会保留；高德轨迹在重新显示或刷新时需要再次转换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original track files and history are kept. AMap tracks need conversion again when shown or refreshed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原軌跡檔案和歷史記錄會保留；高德軌跡在重新顯示或重新整理時需要再次轉換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の軌跡ファイルと履歴は保持されます。高徳の軌跡は再表示または更新時に再変換が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 트랙 파일과 기록은 유지됩니다. 가오더 트랙은 다시 표시하거나 새로 고칠 때 재변환해야 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan los archivos originales y el historial. Los recorridos de AMap se convierten de nuevo al mostrarlos o actualizarlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos originais e o histórico são preservados. Os trajetos do AMap precisam de nova conversão ao serem exibidos ou atualizados."
          }
        }
      }
    },
