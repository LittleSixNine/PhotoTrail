    "选择照片后再匹配定位。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择照片后再匹配定位。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Select photos before matching locations."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇照片後再比對定位。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "写真を選択してから位置を照合してください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "사진을 선택한 후 위치를 매칭하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Selecciona fotos antes de asociar ubicaciones."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Selecione fotos antes de associar localizações."}}
      }
    },
    "选行可查看改名过程；执行范围以上方设置和完整预览为准。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选行可查看改名过程；执行范围以上方设置和完整预览为准。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Select a row to inspect its steps. The scope settings and full preview determine which files are renamed."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "選列可查看重新命名過程；執行範圍以上方設定和完整預覽為準。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "行を選択すると処理の詳細を確認できます。実行対象は上部の範囲設定とプレビュー全体で決まります。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "행을 선택하면 변경 과정을 확인할 수 있습니다. 실제 대상은 위의 범위 설정과 전체 미리보기로 결정됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Selecciona una fila para ver los pasos. El alcance y la vista previa completa determinan los archivos que se renombrarán."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Selecione uma linha para ver as etapas. O escopo e a prévia completa determinam quais arquivos serão renomeados."}}
      }
    },
    "部分照片暂不可编辑，请检查读取或保存结果后重新读取元数据。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "部分照片暂不可编辑，请检查读取或保存结果后重新读取元数据。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Some photos cannot currently be edited. Check the read or save results, then reload metadata."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "部分照片暫不可編輯，請檢查讀取或儲存結果後重新讀取中繼資料。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "一部の写真は現在編集できません。読み込みや保存の結果を確認し、メタデータを再読み込みしてください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "일부 사진은 현재 편집할 수 없습니다. 읽기 또는 저장 결과를 확인한 뒤 메타데이터를 다시 읽으세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Algunas fotos no se pueden editar ahora. Comprueba la lectura o el guardado y vuelve a cargar los metadatos."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Algumas fotos não podem ser editadas agora. Confira a leitura ou o salvamento e recarregue os metadados."}}
      }
    },
    "部分轨迹文件未能导入，请在轨迹卡片中查看。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "部分轨迹文件未能导入，请在轨迹卡片中查看。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Some track files could not be imported. See the tracks panel for details."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "部分軌跡檔案未能匯入，請在軌跡卡片中檢視。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "一部の軌跡ファイルを読み込めませんでした。軌跡パネルで確認してください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "일부 경로 파일을 가져오지 못했습니다. 경로 패널에서 확인하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudieron importar algunos recorridos. Consulta el panel de recorridos."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível importar alguns trajetos. Confira o painel de trajetos."}}
      }
    },
    "重新匹配所选照片，成功匹配的位置会替换现有定位，写入前可撤销。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新匹配所选照片，成功匹配的位置会替换现有定位，写入前可撤销。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Match the selected photos again. Successful matches replace existing locations; undo is available before writing."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新比對所選照片，成功比對的位置會取代現有定位，寫入前可復原。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "選択した写真を再照合します。成功した位置で既存の位置を置き換えます。書き込み前は取り消せます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "선택한 사진을 다시 매칭합니다. 성공한 위치로 기존 위치를 바꾸며, 파일에 쓰기 전에 실행 취소할 수 있습니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Vuelve a asociar las fotos seleccionadas. Las coincidencias correctas reemplazan las ubicaciones existentes y se pueden deshacer antes de escribir."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Associe novamente as fotos selecionadas. As correspondências substituem as localizações existentes e podem ser desfeitas antes de gravar."}}
      }
    },
    "额外文件：%1$@；配对文件一并列入右侧预览。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "额外文件：%1$@；配对文件一并列入右侧预览。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Extra files: %1$@. Paired files are also included in the preview."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "額外檔案：%1$@；配對檔案一併列入右側預覽。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "追加ファイル：%1$@。ペアのファイルも右側のプレビューに含まれます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "추가 파일: %1$@. 연결된 파일도 오른쪽 미리보기에 포함됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Archivos adicionales: %1$@. Los archivos emparejados también aparecen en la vista previa."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Arquivos extras: %1$@. Os arquivos pareados também aparecem na prévia."}}
      }
    },
    "高德仅接收轨迹坐标用于转换；照片和轨迹文件不上传，缓存仅存本机。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "高德仅接收轨迹坐标用于转换；照片和轨迹文件不上传，缓存仅存本机。"}},
        "en": {"stringUnit": {"state": "translated", "value": "AMap receives only track coordinates for conversion. Photos and track files are not uploaded; caches stay on this Mac."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "高德僅接收軌跡座標用於轉換；照片和軌跡檔案不上傳，快取僅存本機。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "高徳には変換用の軌跡座標のみを送信します。写真や軌跡ファイルは送信されず、キャッシュはこの Mac にのみ保存されます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "고덕에는 변환할 경로 좌표만 전송됩니다. 사진과 경로 파일은 업로드하지 않으며 캐시는 이 Mac에만 저장됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "AMap solo recibe coordenadas para convertirlas. No se suben fotos ni archivos de recorrido; la caché permanece en este Mac."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O AMap recebe apenas coordenadas para conversão. Fotos e arquivos de trajeto não são enviados; o cache fica neste Mac."}}
      }
    },
    "仅商品名": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅商品名"}},
        "en": {"stringUnit": {"state": "translated", "value": "Product name only"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅商品名"}},
