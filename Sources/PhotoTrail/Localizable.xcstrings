    "高德地图加载失败，请检查 Key、安全密钥和网络后重新加载。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AMap failed to load, please check the Key, security key and network before reloading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高德地图加载失败，请检查 Key、安全密钥和网络后重新加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高德地圖加載失敗，請檢查 Key、安全密鑰和網絡後重新加載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AMapを読み込めません。Key、セキュリティキー、ネットワークを確認して再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AMap 로드 실패. Key, 보안 키, 네트워크를 확인한 후 다시 불러오세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar AMap. Comprueba la Key, la clave de seguridad y la red antes de recargar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o AMap. Confira a Key, a chave de segurança e a rede antes de recarregar."
          }
        }
      }
    },
