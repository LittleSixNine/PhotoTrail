    "高级选项统一在下方任务选项中设置。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "高级选项统一在下方任务选项中设置。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "高級選项统一在下方任务選项中設置。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Configure advanced options in task options below."}},
        "ja": {"stringUnit": {"state": "translated", "value": "詳細設定は下の処理オプションで設定します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아래 작업 옵션에서 고급 설정을 구성하세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Configure opciones avanzadas en las opciones de tarea inferiores."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Configure opções avançadas nas opções da tarefa abaixo."}}
      }
    },
    "正在重命名文件，请勿关闭程序。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在重命名文件，请勿关闭程序。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在重命名文件，請勿關闭程序。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Renaming files; keep the app open."}},
        "ja": {"stringUnit": {"state": "translated", "value": "名前変更中です。アプリを閉じないでください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "파일 이름 변경 중입니다. 앱을 닫지 마세요."}},
        "es": {"stringUnit": {"state": "translated", "value": "Renombrando archivos; mantenga la aplicación abierta."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Renomeando arquivos; mantenha o aplicativo aberto."}}
      }
    },
    "仅控制后续规则，遇到下一筛选规则重新确定范围。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅控制后续规则，遇到下一筛选规则重新确定范围。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅控制後续規則，遇到下一篩選規則重新确定范围。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Applies to following rules until the next filter resets the scope."}},
        "ja": {"stringUnit": {"state": "translated", "value": "次のフィルターまでのルールに適用し、その後は範囲を再設定します。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "다음 필터가 범위를 다시 정할 때까지 후속 규칙에 적용됩니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Se aplica a reglas siguientes hasta que otro filtro restablezca el ámbito."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aplica-se às regras seguintes até o próximo filtro redefinir o escopo."}}
      }
    },
    "导入本地照片后设置规则，先核对预览，再执行改名。照片图库项目不支持文件改名。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "导入本地照片后设置规则，先核对预览，再执行改名。照片图库项目不支持文件改名。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "導入本地照片後設置規則，先核對預覽，再执行改名。照片圖庫项目不支持文件改名。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Import local photos, configure rules and review before renaming. Photos library items cannot be renamed."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ローカル写真を読み込み、ルールとプレビューを確認して実行します。写真ライブラリ項目の名前変更には未対応です。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "로컬 사진을 가져와 규칙과 미리보기를 확인하세요. 사진 보관함 항목은 이름 변경을 지원하지 않습니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Importe fotos locales, configure reglas y revise antes de renombrar. No se renombra la fototeca."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Importe fotos locais, configure regras e revise antes de renomear. Itens da fototeca não podem ser renomeados."}}
      }
    },
    "将按预览重命名 %1$@ 个文件，包括列表中的配对文件。文件内容不改写；执行记录可用于恢复原名。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "将按预览重命名 %1$@ 个文件，包括列表中的配对文件。文件内容不改写；执行记录可用于恢复原名。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "将按預覽重命名 %1$@ 個文件，包括列表中的配對文件。文件內容不改寫；执行记錄可用于恢複原名。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Rename %1$@ files as previewed, including listed paired files. Contents stay unchanged; history can restore original names."}},
        "ja": {"stringUnit": {"state": "translated", "value": "プレビューどおり、対応ファイルを含む%1$@個の名前を変更します。内容は変更せず、履歴から元の名前に戻せます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "연결 파일을 포함하여 미리보기의 파일 %1$@개를 변경합니다. 내용은 유지되며 기록으로 원래 이름을 복원할 수 있습니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Renombrar %1$@ archivos según la vista previa, incluidos los pareados. El contenido no cambia; el historial permite restaurar nombres."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Renomear %1$@ arquivos conforme a prévia, incluindo pareados. O conteúdo não muda; o histórico permite restaurar nomes."}}
      }
    },
    "恢复前核对文件身份、内容与原名占用；不会覆盖后来创建的文件。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复前核对文件身份、内容与原名占用；不会覆盖后来创建的文件。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢複前核對文件身份、內容與原名占用；不會覆盖後來创建的文件。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore checks identity, contents and original name availability; it never overwrites later files."}},
        "ja": {"stringUnit": {"state": "translated", "value": "復元時にファイルの識別情報、内容、元の名前の使用状況を確認し、後から作成されたファイルは上書きしません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "복원 시 파일 식별 정보, 내용과 원래 이름 사용 여부를 확인하며 나중에 생성된 파일을 덮어쓰지 않습니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Se comprueba identidad, contenido y disponibilidad del nombre original; no se sobrescriben archivos posteriores."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A restauração verifica identidade, conteúdo e disponibilidade do nome original; não sobrescreve arquivos posteriores."}}
      }
    },
    "无时区的拍摄时间按记录的钟面时间使用，不推断拍摄地点时区。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无时区的拍摄时间按记录的钟面时间使用，不推断拍摄地点时区。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無時區的拍摄時間按记錄的鐘面時間使用，不推断拍摄地點時區。"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dates without a timezone use recorded wall-clock time; no shooting timezone is inferred."}},
        "ja": {"stringUnit": {"state": "translated", "value": "タイムゾーンのない撮影日時は記録された時刻を使用し、撮影地のタイムゾーンを推測しません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "시간대 없는 촬영 시간은 기록된 시각을 사용하며 촬영지 시간대를 추정하지 않습니다."}},
        "es": {"stringUnit": {"state": "translated", "value": "Las fechas sin zona usan la hora registrada; no se infiere la zona de captura."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Datas sem fuso usam a hora registrada; o fuso da captura não é inferido."}}
      }
    },
    "每行新名称，或旧名与新名的 TSV": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "每行新名称，或旧名与新名的 TSV"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每行新名稱，或舊名與新名的 TSV"}},
        "en": {"stringUnit": {"state": "translated", "value": "New name per line, or old/new name TSV"}},
        "ja": {"stringUnit": {"state": "translated", "value": "1行1つの新しい名前、または旧名と新名のTSV"}},
        "ko": {"stringUnit": {"state": "translated", "value": "줄당 새 이름 또는 이전/새 이름 TSV"}},
        "es": {"stringUnit": {"state": "translated", "value": "Nombre nuevo por línea o TSV de nombres antiguo/nuevo"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Novo nome por linha ou TSV de nomes antigo/novo"}}
      }
    },
    "词汇大小写例外（每行一个）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "词汇大小写例外（每行一个）"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "詞汇大小寫例外（每行一個）"}},
        "en": {"stringUnit": {"state": "translated", "value": "Case exceptions (one per line)"}},
        "ja": {"stringUnit": {"state": "translated", "value": "大小文字の例外（1行1つ）"}},
        "ko": {"stringUnit": {"state": "translated", "value": "대소문자 예외(줄당 하나)"}},
        "es": {"stringUnit": {"state": "translated", "value": "Excepciones de mayúsculas (una por línea)"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Exceções de maiúsculas (uma por linha)"}}
      }
    },
    "标签模板，例如 <CameraModel>": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "标签模板，例如 <CameraModel>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "標籤模板，例如 <CameraModel>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Tag template, e.g. <CameraModel>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "タグテンプレート（例：<CameraModel>）"}},
        "ko": {"stringUnit": {"state": "translated", "value": "태그 템플릿(예: <CameraModel>)"}},
        "es": {"stringUnit": {"state": "translated", "value": "Plantilla de etiquetas, p. ej. <CameraModel>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Modelo de etiquetas, ex.: <CameraModel>"}}
      }
    },
    "文字": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "文字"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "文字"}},
