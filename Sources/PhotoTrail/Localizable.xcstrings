    "Click on the disclosure indicator to choose a folder where PhotoTrail will place copies of images before performing any updates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click on the disclosure indicator to choose a folder where PhotoTrail will place copies of images before performing any updates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击展开按钮，选择用于保存照片修改前副本的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊展開按鈕，選擇用於保存照片修改前副本的資料夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開閉ボタンをクリックし、更新前の写真を保存するバックアップフォルダを選択してください。"
          }
        },
        "ko": {
