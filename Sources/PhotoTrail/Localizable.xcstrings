    "轨迹时间倒退或重复冲突，未自动匹配。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The track time goes backwards or conflicts repeatedly, and is not automatically matched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轨迹时间倒退或重复冲突，未自动匹配。"
