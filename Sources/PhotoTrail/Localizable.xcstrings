    "导入方案…": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "导入方案…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "導入方案…"}}, "en": {"stringUnit": {"state": "translated", "value": "Import scheme…"}}, "ja": {"stringUnit": {"state": "translated", "value": "プランを読み込む…"}}, "ko": {"stringUnit": {"state": "translated", "value": "방식 가져오기…"}}, "es": {"stringUnit": {"state": "translated", "value": "Importar esquema…"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Importar esquema…"}}}},
    "导出方案…": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "导出方案…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "導出方案…"}}, "en": {"stringUnit": {"state": "translated", "value": "Export scheme…"}}, "ja": {"stringUnit": {"state": "translated", "value": "プランを書き出す…"}}, "ko": {"stringUnit": {"state": "translated", "value": "방식 내보내기…"}}, "es": {"stringUnit": {"state": "translated", "value": "Exportar esquema…"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Exportar esquema…"}}}},
    "方案格式或版本不受支持。": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "方案格式或版本不受支持。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "方案格式或版本不受支持。"}}, "en": {"stringUnit": {"state": "translated", "value": "Unsupported scheme format or version."}}, "ja": {"stringUnit": {"state": "translated", "value": "プランの形式またはバージョンが未対応です。"}}, "ko": {"stringUnit": {"state": "translated", "value": "지원하지 않는 방식 형식 또는 버전입니다."}}, "es": {"stringUnit": {"state": "translated", "value": "Formato o versión de esquema no compatible."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Formato ou versão da esquema não suportado."}}}},
    "为已有定位的图片写入城市数据": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "为已有定位的图片写入城市数据"}}, "en": {"stringUnit": {"state": "translated", "value": "Add city data to geotagged photos"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "為已有定位的圖片寫入城市資料"}}, "ja": {"stringUnit": {"state": "translated", "value": "位置情報のある写真に都市データを追加"}}, "ko": {"stringUnit": {"state": "translated", "value": "위치가 있는 사진에 도시 데이터 추가"}}, "es": {"stringUnit": {"state": "translated", "value": "Añadir datos de ciudad a fotos con ubicación"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Adicionar dados da cidade às fotos com localização"}}}},
    "补齐省、市、区县等地区信息，可用于按城市重命名。": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "补齐省、市、区县等地区信息，可用于按城市重命名。"}}, "en": {"stringUnit": {"state": "translated", "value": "Fill in state, city and district details for renaming by city."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "補齊省、市、區縣等地區資訊，可用於按城市重新命名。"}}, "ja": {"stringUnit": {"state": "translated", "value": "都道府県・市区町村などを補完し、都市名で名前を変更できます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "시·도, 도시, 구·군 정보를 채워 도시별 이름 변경에 사용합니다."}}, "es": {"stringUnit": {"state": "translated", "value": "Completa provincia, ciudad y distrito para renombrar por ciudad."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Preencha estado, cidade e distrito para renomear por cidade."}}}},
    "补齐地区信息": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "补齐地区信息"}}, "en": {"stringUnit": {"state": "translated", "value": "Fill missing region details"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "補齊地區資訊"}}, "ja": {"stringUnit": {"state": "translated", "value": "不足する地域情報を補完"}}, "ko": {"stringUnit": {"state": "translated", "value": "누락된 지역 정보 채우기"}}, "es": {"stringUnit": {"state": "translated", "value": "Completar datos de región"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Completar dados da região"}}}},
    "地区信息已暂存：%1$@ 张；查询失败：%2$@ 张；未补齐：%3$@ 张。请写入所有元数据。": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "地区信息已暂存：%1$@ 张；查询失败：%2$@ 张；未补齐：%3$@ 张。请写入所有元数据。"}}, "en": {"stringUnit": {"state": "translated", "value": "Region details staged: %1$@; lookup failed: %2$@; unchanged: %3$@. Save all metadata."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "地區資訊已暫存：%1$@ 張；查詢失敗：%2$@ 張；未補齊：%3$@ 張。請寫入所有中繼資料。"}}, "ja": {"stringUnit": {"state": "translated", "value": "地域情報を保留：%1$@ 枚。検索失敗：%2$@ 枚。未補完：%3$@ 枚。すべてのメタデータを保存してください。"}}, "ko": {"stringUnit": {"state": "translated", "value": "지역 정보 임시 저장: %1$@장, 조회 실패: %2$@장, 미완료: %3$@장. 모든 메타데이터를 저장하세요."}}, "es": {"stringUnit": {"state": "translated", "value": "Datos preparados: %1$@; consultas fallidas: %2$@; sin cambios: %3$@. Guarda todos los metadatos."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Dados preparados: %1$@; consultas falharam: %2$@; sem alterações: %3$@. Salve todos os metadados."}}}},
    "保存定位时自动补齐地区信息": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "保存定位时自动补齐地区信息"}}, "en": {"stringUnit": {"state": "translated", "value": "Fill region details automatically when saving location"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "儲存定位時自動補齊地區資訊"}}, "ja": {"stringUnit": {"state": "translated", "value": "位置情報の保存時に地域情報を自動補完"}}, "ko": {"stringUnit": {"state": "translated", "value": "위치 저장 시 지역 정보 자동 채우기"}}, "es": {"stringUnit": {"state": "translated", "value": "Completar región al guardar la ubicación"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Completar região ao salvar a localização"}}}},
    "包括省／州、市、区县、国家和国家代码；手动补齐不受此开关影响。": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "包括省／州、市、区县、国家和国家代码；手动补齐不受此开关影响。"}}, "en": {"stringUnit": {"state": "translated", "value": "Includes state, city, district, country and country code. Manual filling works independently."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "包括省／州、市、區縣、國家和國家代碼；手動補齊不受此開關影響。"}}, "ja": {"stringUnit": {"state": "translated", "value": "都道府県、市区町村、国、国コードを含みます。手動補完はこの設定に影響されません。"}}, "ko": {"stringUnit": {"state": "translated", "value": "시·도, 도시, 구·군, 국가 및 국가 코드를 포함합니다. 수동 채우기는 이 설정과 무관합니다."}}, "es": {"stringUnit": {"state": "translated", "value": "Incluye provincia, ciudad, distrito, país y código de país. El relleno manual es independiente."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Inclui estado, cidade, distrito, país e código do país. O preenchimento manual é independente."}}}},
    "文件名示例": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "文件名示例"}}, "en": {"stringUnit": {"state": "translated", "value": "Example filename"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "檔案名稱範例"}}, "ja": {"stringUnit": {"state": "translated", "value": "ファイル名の例"}}, "ko": {"stringUnit": {"state": "translated", "value": "파일 이름 예시"}}, "es": {"stringUnit": {"state": "translated", "value": "Nombre de archivo de ejemplo"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Nome de arquivo de exemplo"}}}},
