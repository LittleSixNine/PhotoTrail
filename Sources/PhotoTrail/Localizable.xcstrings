        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지점은 지원되는 중국 본토 행정구역 밖입니다. 사진 위치는 변경되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
