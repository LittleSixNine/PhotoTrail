    "在同一轨迹段的相邻记录点之间按拍摄时间线性插值。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linear interpolation according to shooting time between adjacent recording points of the same track segment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一轨迹段的相邻记录点之间按拍摄时间线性插值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一軌跡段的相鄰記錄點之間按拍攝時間線性插值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ軌跡区間の隣接点間で、撮影日時に基づき線形補間します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 경로 구간의 인접 지점 사이에서 촬영 시간에 따라 선형 보간합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interpola linealmente según la hora de captura entre puntos adyacentes del mismo segmento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpolação linear pela hora de captura entre pontos adjacentes do mesmo segmento."
          }
        }
      }
    },
