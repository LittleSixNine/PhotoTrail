    "拍摄时间＋原名": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "拍摄时间＋原名"}}, "en": {"stringUnit": {"state": "translated", "value": "Capture time + original name"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "拍攝時間＋原名"}}, "ja": {"stringUnit": {"state": "translated", "value": "撮影日時＋元の名前"}}, "ko": {"stringUnit": {"state": "translated", "value": "촬영 시간＋원래 이름"}}, "es": {"stringUnit": {"state": "translated", "value": "Fecha de captura + nombre original"}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Data de captura + nome original"}}}},
