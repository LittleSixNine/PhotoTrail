    "没有匹配机型，可直接输入自定义值。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配机型，可直接输入自定义值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching model. You can enter a custom value below."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有符合的機型，可直接輸入自訂值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致する機種がありません。下に任意の値を入力できます。"
          }
        },
