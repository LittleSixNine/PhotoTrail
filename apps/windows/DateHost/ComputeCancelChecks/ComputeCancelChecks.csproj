<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems><EnableDefaultPageItems>false</EnableDefaultPageItems></PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  <Compile Include="../../PhotoTrail.Windows/*.cs" Exclude="../../PhotoTrail.Windows/DateAdapter.cs;../../PhotoTrail.Windows/App.xaml.cs" Link="Production/%(Filename)%(Extension)" />
  <Compile Include=".cache/DateAdapter.cs" /><Compile Include="Program.cs" />
  <Page Include="../../PhotoTrail.Windows/MainWindow.xaml" Link="MainWindow.xaml" />
  <Content Include="../bin/*" Link="DateHost/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
 </ItemGroup>
</Project>
