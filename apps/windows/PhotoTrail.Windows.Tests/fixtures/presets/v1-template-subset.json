      "replacement": "unused",
      "anchor": "old",
      "position": 1,
      "length": 1,
      "occurrence": "all",
      "matchNumber": 1,
      "caseSensitive": true,
      "start": 1,
      "counter": 0,
      "step": 1,
      "padding": 3,
      "alphabetStart": "A",
      "alphabetWidth": 1,
      "lexicalCases": {
        "Noun": "title",
        "Verb": "title",
        "Adjective": "title",
        "Adverb": "title",
        "Interjection": "title",
        "Pronoun": "lower",
        "Determiner": "lower",
        "Preposition": "lower",
        "Conjunction": "lower",
        "Particle": "lower",
        "Number": "keep",
        "Classifier": "keep",
        "Idiom": "keep",
        "OtherWord": "keep"
      },
      "prefix": "unused-prefix",
      "suffix": "unused-suffix",
      "numberOperation": "add",
      "numberValue": 1,
      "dateSource": "shooting",
      "dateFormat": "unused-format",
      "timeZone": "source",
      "nightHour": 0,
      "skipMissing": true,
      "fullMatch": false,
      "perDirectory": false,
      "filterAny": false,
      "filters": [
