{
  "id": "33333333-3333-4333-8333-333333333333",
  "version": 1,
  "name": "Source-shaped template fixture",
  "rules": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "action": 66,
      "enabled": true,
      "part": "stem",
