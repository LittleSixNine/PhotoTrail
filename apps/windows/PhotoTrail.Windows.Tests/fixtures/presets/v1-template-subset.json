    "descending": false,
    "keepFirst": false,
    "pair": false,
    "sourceExtensions": "jpg,jpeg,heic,cr3,cr2,nef,arw,dng,raf",
    "targetExtensions": "xmp",
    "datePriority": "Composite:SubSecDateTimeOriginal\nComposite:DateTimeOriginal\nExifIFD:DateTimeOriginal\nXMP-exif:DateTimeOriginal\nExifIFD:CreateDate\nQuickTime:CreationDate\nQuickTime:DateTimeOriginal\nQuickTime:ContentCreateDate\nQuickTime:CreateDate\nQuickTime:MediaCreateDate\nID3:Date\nXMP-xmp:CreateDate"
  },
  "example": "old.jpg"
