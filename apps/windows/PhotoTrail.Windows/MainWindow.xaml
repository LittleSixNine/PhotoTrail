<Window x:Class="PhotoTrail.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 ThemeMode="System" Title="PhotoTrail Windows · 阶段3—6开发测试版" Width="1120" Height="760" MinWidth="720" MinHeight="480"
 PreviewKeyDown="WindowKeyDown" Loaded="WindowLoaded" Closing="WindowClosing" Closed="WindowClosed" AllowDrop="True" Drop="FilesDropped">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
   <TextBlock Text="PhotoTrail" FontSize="26" FontWeight="SemiBold" />
   <TextBlock Text="Windows 开发测试版 · XMP副本／地图与地区／可恢复重命名／CSV" Margin="0,4,0,10" />
   <WrapPanel>
    <Button x:Name="ReadButton" Content="导入照片" ToolTip="导入照片 · Ctrl+O" AutomationProperties.AcceleratorKey="Ctrl+O" Padding="12,6" Click="ReadPhoto" />
    <Button x:Name="FolderButton" Content="导入文件夹" ToolTip="导入文件夹 · Ctrl+Shift+O" AutomationProperties.AcceleratorKey="Ctrl+Shift+O" Padding="12,6" Margin="8,0,0,0" Click="ReadFolder" />
    <Button x:Name="RemoveButton" Content="移除所选" Padding="12,6" Margin="8,0,0,0" Click="RemovePhotos" IsEnabled="False" />
    <Button Content="取消任务" ToolTip="取消进行中的任务 · Esc" AutomationProperties.AcceleratorKey="Esc" Padding="12,6" Margin="8,0,0,0" Click="CancelRead" />
   </WrapPanel>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="导入照片或拖入文件。原文件不会被修改。" TextWrapping="Wrap" Margin="0,10,0,0" />
  <TabControl x:Name="WorkspaceTabs" SelectionChanged="MapSelected">
   <TabItem Header="元数据">
    <Grid Margin="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
       <TextBlock Text="文件名搜索"/><TextBox x:Name="PhotoSearch" ToolTip="搜索文件名 · F3" AutomationProperties.AcceleratorKey="F3" MaxLength="256" AutomationProperties.Name="文件名搜索" TextChanged="PhotoViewChanged" Margin="0,4"/>
       <ComboBox x:Name="PhotoFilter" SelectedIndex="0" AutomationProperties.Name="照片筛选" SelectionChanged="PhotoViewChanged" Margin="0,0,0,4"><ComboBoxItem Content="全部照片"/><ComboBoxItem Content="有草稿"/><ComboBoxItem Content="无草稿"/><ComboBoxItem Content="有定位"/><ComboBoxItem Content="无定位"/></ComboBox>
       <ComboBox x:Name="PhotoSort" SelectedIndex="0" AutomationProperties.Name="照片排序" SelectionChanged="PhotoViewChanged"><ComboBoxItem Content="导入顺序"/><ComboBoxItem Content="文件名升序"/><ComboBoxItem Content="文件名降序"/></ComboBox>
       <TextBlock x:Name="PhotoCount" Text="显示0／总计0；草稿0" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
      <ListBox x:Name="Photos" SelectionMode="Extended" SelectionChanged="PhotoSelected" HorizontalContentAlignment="Stretch">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,6"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
     <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="SelectionInfo" Text="请选择照片。Ctrl / Shift 可多选。" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TabControl Grid.Row="1" SelectionChanged="PhotoPreviewTabChanged">
       <TabItem Header="编辑草稿">
        <DockPanel>
         <WrapPanel x:Name="DraftActions" DockPanel.Dock="Bottom" Margin="10,6" IsEnabled="False"><Button Content="加入草稿" Click="ApplyDraft" Padding="12,6"/><Button Content="撤销所选草稿" Click="UndoDraft" Padding="12,6" Margin="8,0,0,0"/></WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel x:Name="Editor" Margin="10" IsEnabled="False">
          <TextBlock Text="只应用勾选字段。勾选并留空会清除该字段；混合值不自动应用。" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <CheckBox x:Name="AuthorApply" Content="作者 · 每行一项"/><TextBox x:Name="AuthorValue" AutomationProperties.Name="作者" AcceptsReturn="True" MinHeight="42" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="TitleApply" Content="标题 · x-default"/><TextBox x:Name="TitleValue" AutomationProperties.Name="标题" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="DescriptionApply" Content="说明 · x-default"/><TextBox x:Name="DescriptionValue" AutomationProperties.Name="说明" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="KeywordsApply" Content="关键词 · 每行一项"/><TextBox x:Name="KeywordsValue" AutomationProperties.Name="关键词" AcceptsReturn="True" MinHeight="42" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="RightsApply" Content="版权 · x-default"/><TextBox x:Name="RightsValue" AutomationProperties.Name="版权" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="RatingApply" Content="评分 · 0至5，-1拒绝，留空清除"/><TextBox x:Name="RatingValue" AutomationProperties.Name="评分" MaxLength="2" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="LabelApply" Content="标签 · 自定义文字"/><TextBox x:Name="LabelValue" AutomationProperties.Name="标签" MaxLength="256" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="DateApply" Content="XMP 拍摄时间"/><TextBox x:Name="DateValue" AutomationProperties.Name="拍摄时间" TextChanged="EditorChanged" Margin="0,4,0,4"/>
          <TextBlock Text="格式：yyyy:MM:dd HH:mm:ss，可附小数秒及Z/±hh:mm；不改 EXIF / IPTC。" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <CheckBox x:Name="DigitizedApply" Content="XMP 数字化时间"/><TextBox x:Name="DigitizedValue" AutomationProperties.Name="数字化时间 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="CreateDateApply" Content="XMP 创建时间"/><TextBox x:Name="CreateDateValue" AutomationProperties.Name="创建时间 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="ModifyDateApply" Content="XMP 修改时间"/><TextBox x:Name="ModifyDateValue" AutomationProperties.Name="修改时间 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <TextBlock Text="以上时间分别勾选；批量日期只调整拍摄时间，不自动同步其他日期或文件时间。" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <CheckBox x:Name="CountryApply" Content="国家 · 手填"/><TextBox x:Name="CountryValue" AutomationProperties.Name="国家" MaxLength="256" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="StateApply" Content="省／州 · 手填"/><TextBox x:Name="StateValue" AutomationProperties.Name="省／州" MaxLength="256" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="CityApply" Content="城市 · 手填"/><TextBox x:Name="CityValue" AutomationProperties.Name="城市" MaxLength="256" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="LocationApply" Content="区／地点 · 手填"/><TextBox x:Name="LocationValue" AutomationProperties.Name="区／地点" MaxLength="256" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="CountryCodeApply" Content="国家代码 · 三字母，例如CHN · 手填"/><TextBox x:Name="CountryCodeValue" AutomationProperties.Name="国家代码 · 三字母，例如CHN" MaxLength="256" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <TextBlock Text="设备信息 · 只写XMP，原EXIF设备字段保留" TextWrapping="Wrap" Margin="0,8,0,10"/>
          <CheckBox x:Name="MakeApply" Content="制造商 · XMP-tiff:Make"/><TextBox x:Name="MakeValue" AutomationProperties.Name="制造商 · XMP" MaxLength="8192" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="ModelApply" Content="设备型号 · XMP-tiff:Model"/><TextBox x:Name="ModelValue" AutomationProperties.Name="设备型号 · XMP" MaxLength="8192" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="LensApply" Content="镜头 · XMP-aux:Lens"/><TextBox x:Name="LensValue" AutomationProperties.Name="镜头 · XMP" MaxLength="8192" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="LensSerialApply" Content="镜头序列号 · XMP-aux:LensSerialNumber"/><TextBox x:Name="LensSerialValue" AutomationProperties.Name="镜头序列号 · XMP" MaxLength="8192" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <TextBlock Text="曝光参数 · 只写XMP；可输入数值或分数，如1/125" TextWrapping="Wrap" Margin="0,8,0,10"/>
          <CheckBox x:Name="ExposureTimeApply" Content="曝光时间 · 秒 · 0.000001至86400"/><TextBox x:Name="ExposureTimeValue" AutomationProperties.Name="曝光时间 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="FNumberApply" Content="光圈 · 0.1至128"/><TextBox x:Name="FNumberValue" AutomationProperties.Name="光圈 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="IsoApply" Content="ISO · 整数1至1000000"/><TextBox x:Name="IsoValue" AutomationProperties.Name="ISO · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="FocalLengthApply" Content="焦距 · mm · 0.1至10000"/><TextBox x:Name="FocalLengthValue" AutomationProperties.Name="焦距 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="ExposureBiasApply" Content="曝光补偿 · EV · -100至100"/><TextBox x:Name="ExposureBiasValue" AutomationProperties.Name="曝光补偿 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="ExposureProgramApply" Content="曝光程序 · 整数0至8"/><TextBox x:Name="ExposureProgramValue" AutomationProperties.Name="曝光程序 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="WhiteBalanceApply" Content="白平衡 · 0自动／1手动"/><TextBox x:Name="WhiteBalanceValue" AutomationProperties.Name="白平衡 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
         </StackPanel>
        </ScrollViewer>
        </DockPanel>
       </TabItem>
       <TabItem Header="字段剪贴板">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
         <TextBlock Text="复制当前所选照片的同一个原始字段值（包含草稿）。值不一致或缺失时不能复制。文本框自身Ctrl+C/V仍使用原生行为。" TextWrapping="Wrap"/>
         <TextBlock Text="GPS坐标仅复制单张照片的WGS-84经纬度（包含草稿），不包含海拔/时间/地区。选择目标后先预览，再在地图页加入GPS草稿并保存副本；未知海拔/测量时间清除旧XMP值。" TextWrapping="Wrap" Margin="0,12,0,8"/>
         <WrapPanel><Button Content="复制所选GPS坐标" Click="CopyGpsClipboard" Padding="10,6" Margin="0,0,8,0"/><Button Content="预览剪贴板GPS坐标" Click="PreviewGpsClipboard" Padding="10,6"/></WrapPanel>         <ComboBox x:Name="ClipboardField" DisplayMemberPath="Name" SelectedValuePath="Tag" SelectedIndex="0" AutomationProperties.Name="复制字段" Margin="0,10"/>
         <Button Content="复制字段值" Click="CopyField" HorizontalAlignment="Left" Padding="10,6"/>
         <TextBlock Text="粘贴前，在编辑草稿页勾选目标字段。先完整验证，再把同一个字面值填入全部勾选字段；不会直接加入草稿或写入照片。" TextWrapping="Wrap" Margin="0,12,0,8"/>
         <Button Content="将剪贴板填入勾选字段" Click="PasteFields" HorizontalAlignment="Left" Padding="10,6"/>
         <TextBlock Text="切回编辑草稿页核对并明确加入草稿，最后手动保存副本。作者/关键词按换行分项；日期保留原始精度和时区，不转换显示值。" TextWrapping="Wrap" Margin="0,12"/>
        </StackPanel></ScrollViewer>
       </TabItem>
       <TabItem Header="字段预设">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
         <TextBlock Text="保存编辑草稿页当前勾选字段为JSON预设。载入只填入编辑区，不自动加入草稿或写入照片。" TextWrapping="Wrap"/>
         <TextBlock Text="预设名称" Margin="0,10,0,4"/><TextBox x:Name="PresetName" Text="我的预设" MaxLength="80" AutomationProperties.Name="预设名称"/>
         <Button Content="保存勾选字段为预设…" Click="SavePreset" HorizontalAlignment="Left" Padding="10,6" Margin="0,8"/>
         <TextBlock Text="预设文件"/><DockPanel Margin="0,4"><Button Content="选择…" DockPanel.Dock="Right" Click="ChoosePreset" Padding="10,5" Margin="8,0,0,0"/><TextBox x:Name="PresetPath" AutomationProperties.Name="预设文件"/></DockPanel>
         <Button Content="载入预设到编辑区" Click="LoadPreset" HorizontalAlignment="Left" Padding="10,6" Margin="0,8"/>
         <TextBlock Text="当前支持13个手填XMP字段的替换/清除。未知字段、追加、日期链等复杂Mac预设会完整拒绝，不静默执行部分操作。载入后切回编辑草稿页核对勾选内容，再明确加入所选照片草稿。" TextWrapping="Wrap" Margin="0,0,0,10"/>
         <TextBlock x:Name="PresetPreview" Text="尚未载入。" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
       </TabItem>
       <TabItem Header="批量日期">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
          <TextBlock Text="仅调整所选XMP拍摄时间；不改EXIF、IPTC、文件系统时间。当前草稿作为起点。" TextWrapping="Wrap"/>
          <ComboBox x:Name="DateMode" SelectedIndex="0" SelectionChanged="DatePlanChanged" AutomationProperties.Name="日期操作" Margin="0,8"><ComboBoxItem Content="调整各自日期"/><ComboBoxItem Content="按当前选择顺序设置序列"/><ComboBoxItem Content="替换指定日期组件"/><ComboBoxItem Content="按当前选择顺序均匀分布"/><ComboBoxItem Content="从文件名捕获日期"/></ComboBox>
          <StackPanel x:Name="DateShiftOptions">
          <TextBlock Text="调整量（整数，可负；依次应用年、月、日、时、分、秒）" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,6">
           <TextBlock Text="年" VerticalAlignment="Center"/><TextBox x:Name="DateYears" Text="0" Width="50" Margin="4" AutomationProperties.Name="调整年" TextChanged="DatePlanChanged"/>
           <TextBlock Text="月" VerticalAlignment="Center"/><TextBox x:Name="DateMonths" Text="0" Width="50" Margin="4" AutomationProperties.Name="调整月" TextChanged="DatePlanChanged"/>
           <TextBlock Text="日" VerticalAlignment="Center"/><TextBox x:Name="DateDays" Text="0" Width="50" Margin="4" AutomationProperties.Name="调整日" TextChanged="DatePlanChanged"/>
           <TextBlock Text="时" VerticalAlignment="Center"/><TextBox x:Name="DateHours" Text="0" Width="50" Margin="4" AutomationProperties.Name="调整小时" TextChanged="DatePlanChanged"/>
           <TextBlock Text="分" VerticalAlignment="Center"/><TextBox x:Name="DateMinutes" Text="0" Width="50" Margin="4" AutomationProperties.Name="调整分钟" TextChanged="DatePlanChanged"/>
           <TextBlock Text="秒" VerticalAlignment="Center"/><TextBox x:Name="DateSeconds" Text="0" Width="80" Margin="4" AutomationProperties.Name="调整秒" TextChanged="DatePlanChanged"/>
          </WrapPanel>
          </StackPanel>
          <StackPanel x:Name="DateReplaceOptions" Visibility="Collapsed">
          <TextBlock Text="组件替换（整数；留空保留，0只对时/分/秒有效；保留原小数秒和固定时区）" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,6">
           <TextBlock Text="年" VerticalAlignment="Center"/><TextBox x:Name="DateReplaceYear" Width="60" Margin="4" MaxLength="8" AutomationProperties.Name="替换年" TextChanged="DatePlanChanged"/>
           <TextBlock Text="月" VerticalAlignment="Center"/><TextBox x:Name="DateReplaceMonth" Width="60" Margin="4" MaxLength="8" AutomationProperties.Name="替换月" TextChanged="DatePlanChanged"/>
           <TextBlock Text="日" VerticalAlignment="Center"/><TextBox x:Name="DateReplaceDay" Width="60" Margin="4" MaxLength="8" AutomationProperties.Name="替换日" TextChanged="DatePlanChanged"/>
           <TextBlock Text="时" VerticalAlignment="Center"/><TextBox x:Name="DateReplaceHour" Width="60" Margin="4" MaxLength="8" AutomationProperties.Name="替换时" TextChanged="DatePlanChanged"/>
           <TextBlock Text="分" VerticalAlignment="Center"/><TextBox x:Name="DateReplaceMinute" Width="60" Margin="4" MaxLength="8" AutomationProperties.Name="替换分" TextChanged="DatePlanChanged"/>
           <TextBlock Text="秒" VerticalAlignment="Center"/><TextBox x:Name="DateReplaceSecond" Width="60" Margin="4" MaxLength="8" AutomationProperties.Name="替换秒" TextChanged="DatePlanChanged"/>
          </WrapPanel>
          </StackPanel>
          <StackPanel x:Name="DateStartOptions" Visibility="Collapsed">
          <TextBlock Text="序列/分布起点（yyyy:MM:dd HH:mm:ss，可附小数秒及Z/±hh:mm）" TextWrapping="Wrap"/>
          <TextBox x:Name="DateStart" AutomationProperties.Name="日期序列起点" TextChanged="DatePlanChanged" Margin="0,4"/>
          </StackPanel>
          <DockPanel x:Name="DateSequenceOptions" Visibility="Collapsed" Margin="0,4"><TextBlock Text="序列间隔秒" DockPanel.Dock="Left" VerticalAlignment="Center"/><TextBox x:Name="DateStep" Text="1" Width="100" HorizontalAlignment="Left" Margin="8,0" AutomationProperties.Name="日期序列间隔秒" TextChanged="DatePlanChanged"/></DockPanel>
          <StackPanel x:Name="DateDistributionOptions" Visibility="Collapsed">
          <TextBlock Text="分布终点（起止小数秒/时区须完全相同；按最近整秒分配，可出现相同时间；单张采用起点）" TextWrapping="Wrap"/>
          <TextBox x:Name="DateEnd" AutomationProperties.Name="日期分布终点" TextChanged="DatePlanChanged" Margin="0,4"/>
          </StackPanel>
          <StackPanel x:Name="DateFilenameOptions" Visibility="Collapsed">
          <TextBlock Text="文件名日期正则（最多1024字；普通捕获组，不支持前后查找/反向引用）" TextWrapping="Wrap"/>
          <TextBox x:Name="DateFilenamePattern" Text="([0-9]{4})([0-9]{2})([0-9]{2})_([0-9]{2})([0-9]{2})([0-9]{2})" MaxLength="1024" AutomationProperties.Name="文件名日期正则" TextChanged="DatePlanChanged" Margin="0,4"/>
          <TextBlock Text="日期模板（$1等捕获组；不匹配/非法日期逐项跳过，不猜测当前时间或时区）" TextWrapping="Wrap"/>
          <TextBox x:Name="DateFilenameTemplate" Text="$1:$2:$3 $4:$5:$6" MaxLength="512" AutomationProperties.Name="文件名日期模板" TextChanged="DatePlanChanged" Margin="0,4"/>
          </StackPanel>
          <WrapPanel Margin="0,8"><Button Content="预览日期" Click="PreviewDates" Padding="10,5"/><Button x:Name="DatePlanApplyButton" Content="将日期预览加入草稿" Click="ApplyDates" IsEnabled="False" Padding="10,5" Margin="8,0"/><Button Content="取消日期预览" Click="CancelRead" Padding="10,5"/></WrapPanel>
          <TextBlock Text="缺失/非法日期不会猜测；闰日或31日调整落入非法日期会拒绝。无时区保持无时区，小数秒和固定偏移原样保留；不处理时区夏令时切换。" TextWrapping="Wrap" Margin="0,0,0,8"/>
         <TextBlock x:Name="DatePlanPreview" Text="尚未预览。" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
       </TabItem>
       <TabItem Header="XMP交换">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
         <TextBlock Text="导出一个文件的完整现有XMP包及当前草稿，不包含EXIF/IPTC到XMP的转换。缺少XMP时从空包及草稿生成。文件不覆盖，原文件不修改。" TextWrapping="Wrap"/>
         <Button Content="导出完整XMP及草稿…" Click="ExportXmp" HorizontalAlignment="Left" Padding="10,6" Margin="0,8"/>
         <TextBlock Text="导入XMP仅载入当前13个手填字段到编辑区，缺失字段不清除。GPS、其他语言及其他字段只提示未导入，不自动写照片。" TextWrapping="Wrap" Margin="0,8"/>
         <DockPanel><Button Content="选择…" DockPanel.Dock="Right" Click="ChooseXmp" Padding="10,5" Margin="8,0,0,0"/><TextBox x:Name="XmpPath" AutomationProperties.Name="XMP字段来源"/></DockPanel>
         <Button Content="载入XMP字段到编辑区" Click="ImportXmp" HorizontalAlignment="Left" Padding="10,6" Margin="0,8"/>
         <TextBlock Text="XMP上限8MiB，拒绝DTD/外部实体及非法字段，全部验证后才填入。核对勾选字段再加入草稿，最后保存副本。" TextWrapping="Wrap"/>
         <TextBlock x:Name="XmpPreview" Text="尚未载入。" TextWrapping="Wrap" Margin="0,10"/>
        </StackPanel></ScrollViewer>
       </TabItem>
       <TabItem x:Name="PhotoPreviewTab" Header="照片预览">
        <DockPanel Margin="8"><TextBlock x:Name="PhotoPreviewStatus" DockPanel.Dock="Bottom" Text="请选择一张JPEG/PNG/DNG照片。DNG使用内嵌JPEG预览，不改照片。" TextWrapping="Wrap" Margin="0,8,0,0"/><Image x:Name="PhotoPreviewImage" Stretch="Uniform" AutomationProperties.Name="所选照片预览"/></DockPanel>
       </TabItem>
       <TabItem Header="原始字段"><DataGrid x:Name="MetadataGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="来源 / 字段" Binding="{Binding Tag}" Width="260"/><DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
      </TabControl>
      <StackPanel Grid.Row="2" Margin="0,10,0,0">
       <TextBlock Text="输出文件夹（须已存在；同名文件不覆盖）"/>
       <DockPanel Margin="0,4,0,6"><Button x:Name="OutputButton" DockPanel.Dock="Right" Content="选择…" Click="ChooseOutput" Padding="10,4" Margin="6,0,0,0"/><TextBox x:Name="OutputFolder" AutomationProperties.Name="输出文件夹" VerticalContentAlignment="Center"/></DockPanel>
       <Button x:Name="SaveButton" Content="保存所选草稿为副本" ToolTip="保存所选草稿为副本 · Ctrl+S" AutomationProperties.AcceleratorKey="Ctrl+S" Click="SaveCopies" Padding="12,6" HorizontalAlignment="Left" IsEnabled="False"/>
      </StackPanel>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="地图">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Top" Margin="8">
      <Button x:Name="TrackReadButton" Content="导入轨迹" Click="ReadTracks" Padding="12,6"/>
      <ComboBox x:Name="TrackList" Width="250" Margin="8,0" DisplayMemberPath="Name" SelectionChanged="TrackSelected" AutomationProperties.Name="当前轨迹"/>
      <Button x:Name="TrackRemoveButton" Content="移除当前轨迹" Click="RemoveTrack" Padding="12,6"/>
      <Button x:Name="MapRetryButton" Content="重载地图" Click="RetryMap" Padding="12,6" Margin="8,0,0,0"/>
     </WrapPanel>
     <WrapPanel DockPanel.Dock="Top" Margin="8,0,8,8">
      <TextBlock Text="最近轨迹" VerticalAlignment="Center"/>
      <ComboBox x:Name="RecentTracks" Width="440" Margin="8,0" AutomationProperties.Name="最近轨迹路径"/>
      <Button x:Name="RecentTrackReadButton" Content="重新读取所选历史" Click="ReadRecentTrack" Padding="10,5"/>
      <TextBlock x:Name="TrackHistoryStatus" Text="历史仅保存本机路径，不自动加载轨迹。" TextWrapping="Wrap" Margin="8,0" VerticalAlignment="Center"/>
     </WrapPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="8">
      <TextBlock x:Name="TrackInfo" Text="支持GPX／KML／KMZ；轨迹留在本机，仅显示和匹配预览。" TextWrapping="Wrap"/>
      <TextBlock x:Name="MatchPhotoInfo" Text="匹配照片沿用元数据页的选择；无时区时间须手动提供明确匹配时间。" TextWrapping="Wrap" Margin="0,6,0,4"/>
      <DockPanel><Button x:Name="MatchButton" DockPanel.Dock="Right" Content="预览时间匹配" Click="MatchTrack" Padding="10,5" Margin="8,0,0,0"/><TextBox x:Name="MatchTimeValue" AutomationProperties.Name="轨迹匹配时间" VerticalContentAlignment="Center"/></DockPanel>
      <TextBlock x:Name="MatchResult" Text="匹配时间格式：2026-10-04T00:00:30Z，必须包含时区。尚未写入GPS。" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <Button Content="Google查询预览位置（联网）" Click="LookupPlace" HorizontalAlignment="Left" Padding="10,5" Margin="0,4,0,0"/>
      <TextBlock x:Name="PlacePreview" Text="地区查询只预览；Google Maps结果不自动写入照片。" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <Button x:Name="GpsDraftButton" Content="将预览位置加入所选照片的 GPS 草稿" Click="AddGpsDraft" IsEnabled="False" HorizontalAlignment="Left" Padding="10,5" Margin="0,6,0,0"/>
     </StackPanel>
     <wv:WebView2 x:Name="MapView" Loaded="MapLoaded" />
    </DockPanel>
   </TabItem>
   <TabItem Header="地图设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16" MaxWidth="700" HorizontalAlignment="Left">
     <TextBlock Text="运行环境" FontSize="20" FontWeight="SemiBold"/>
     <Button x:Name="EnvironmentCheckButton" Content="检查本机环境" Click="CheckDependencies" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,8"/>
     <TextBlock x:Name="DependencyStatus" Text="可检查.NET、WebView2与ExifTool；只读取本机环境。" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <TextBlock Text="Google Maps 自备密钥" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="默认地图仍为免费的OpenFreeMap，无需密钥。保存密钥后可明确选择Google地图；仅当前会话使用，重启默认回到OpenFreeMap。" TextWrapping="Wrap" Margin="0,10,0,10"/>
     <TextBlock Text="使用Google服务需自行配置项目、相应API及计费，并设置密钥限制与配额；保存密钥不代表验证成功，也不会产生Google请求。" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <Label Content="Google API密钥" Target="{Binding ElementName=GoogleKeyInput}"/>
     <PasswordBox x:Name="GoogleKeyInput" AutomationProperties.Name="Google API密钥" MaxLength="256" Width="420" HorizontalAlignment="Left"/>
     <WrapPanel Margin="0,12,0,12"><Button Content="保存本机密钥" Click="SaveGoogleKey" Padding="12,6"/><Button Content="删除本机密钥" Click="ClearGoogleKey" Padding="12,6" Margin="8,0,0,0"/></WrapPanel>
     <WrapPanel Margin="0,0,0,12"><Button Content="使用Google地图（联网）" Click="UseGoogleMap" Padding="12,6"/><Button Content="使用默认地图" Click="UseDefaultMap" Padding="12,6" Margin="8,0,0,0"/></WrapPanel>
     <TextBlock Text="Google使用时密钥会交给网页SDK并随请求发送，DPAPI仅保护本机存储。HTTP来源限制应匹配https://phototrail.local/*；启用Maps JavaScript API与Geocoding API。地区结果当前只预览，不自动保存。" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock x:Name="GoogleKeyStatus" Text="尚未保存本机密钥。" TextWrapping="Wrap"/>
     <TextBlock Text="密钥以Windows当前用户保护的数据保存；不会回显、进入项目源码或开发日志。更换电脑/用户后请重新输入。同一Windows用户运行的程序仍可能访问它；它不能替代Google的密钥限制。" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="重命名">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="沿用元数据页所选照片；规则从上到下作用于不含扩展名的名称。每行一条：前缀|旅行_、后缀|_成片、替换|旧|新、设名|新名称、大写、小写、序号|起始|步长|位数。扩展名保留。" TextWrapping="Wrap"/>
     <DockPanel Grid.Row="1" Margin="0,10,0,10"><Button x:Name="FreezeRenameButton" DockPanel.Dock="Right" Content="检查冲突并冻结" Click="FreezeRename" Padding="12,6" Margin="10,0,0,0"/><TextBox x:Name="RenameRules" AutomationProperties.Name="重命名规则链" Text="前缀|旅行_" TextChanged="RenameRulesChanged" AcceptsReturn="True" MaxLength="32768" Height="90" VerticalScrollBarVisibility="Auto"/></DockPanel>
     <DataGrid x:Name="RenamePreview" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="原名" Binding="{Binding OriginalName}" Width="*"/><DataGridTextColumn Header="新名" Binding="{Binding NewName}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="200"/></DataGrid.Columns></DataGrid>
     <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <WrapPanel><Button x:Name="RenamePresetSaveButton" Content="保存规则…" Click="SaveRenamePreset" Padding="10,6" Margin="0,0,8,0"/><Button x:Name="RenamePresetLoadButton" Content="载入规则…" Click="LoadRenamePreset" Padding="10,6" Margin="0,0,12,0"/><CheckBox x:Name="RenameSort" Content="按名称排序后编号" Checked="RenameRulesChanged" Unchecked="RenameRulesChanged" VerticalAlignment="Center"/><Button x:Name="ExecuteRenameButton" Content="执行冻结计划" Click="ExecuteRename" IsEnabled="False" Padding="12,6" Margin="10,0,0,0"/></WrapPanel>
      <TextBlock Text="执行记录路径（恢复会验证实际文件内容，不覆盖其他文件）" Margin="0,8,0,4"/>
      <DockPanel><Button x:Name="RestoreRenameButton" DockPanel.Dock="Right" Content="按记录恢复原名" Click="RestoreRename" Padding="12,6" Margin="8,0,0,0"/><TextBox x:Name="RenameJournalPath" AutomationProperties.Name="重命名执行记录" MaxLength="32768"/></DockPanel>
      <TextBlock x:Name="RenameStatus" Text="预览不修改文件；冻结后才可执行，成功/失败/取消均保留实际名称记录。" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="CSV">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="CSV · 沿用元数据页当前选择" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="回导CSV的值使用JSON字符串或列表；空单元不修改，@clear明确清除。只匹配当前选择的身份与相对路径，跨电脑路径改变后不能直接匹配。" TextWrapping="Wrap" Margin="0,8"/>
      <WrapPanel><Button Content="导出回导CSV…" Click="ExportRoundtripCsv" Padding="10,6"/><Button Content="导出显示CSV…" Click="ExportDisplayCsv" Padding="10,6" Margin="8,0"/></WrapPanel>
      <TextBlock Text="导入文件" Margin="0,12,0,4"/>
      <DockPanel><Button Content="选择…" DockPanel.Dock="Right" Click="ChooseCsv" Padding="10,5" Margin="8,0,0,0"/><TextBox x:Name="CsvPath" AutomationProperties.Name="CSV导入文件" TextChanged="CsvChanged"/></DockPanel>
      <WrapPanel Margin="0,8"><Button Content="预览CSV" Click="PreviewCsv" Padding="10,6"/><Button x:Name="CsvApplyButton" Content="将预览加入草稿" Click="ApplyCsv" IsEnabled="False" Padding="10,6" Margin="8,0"/></WrapPanel>
      <TextBlock Text="预览不会写入照片。应用后可在元数据页撤销，保存仍只创建副本且不覆盖已有文件。显示CSV有公式防护，不能回导；Google查询结果不导出。" TextWrapping="Wrap" Margin="0,0,0,8"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="CsvPreview" Text="尚未预览。" TextWrapping="Wrap"/></ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem Header="应用设置">
    <StackPanel Margin="16"><TextBlock Text="外观" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="默认跟随Windows系统；更改后保存本机外观偏好，重启恢复。" TextWrapping="Wrap" Margin="0,8"/>
     <ComboBox x:Name="ThemeChoice" Width="220" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="ThemeChanged" AutomationProperties.Name="应用外观"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
     <TextBlock x:Name="ThemeStatus" Text="默认跟随Windows系统外观；不改变系统设置。" TextWrapping="Wrap" Margin="0,8"/>
    </StackPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
