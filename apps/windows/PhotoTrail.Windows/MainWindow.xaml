<Window x:Class="PhotoTrail.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PhotoTrail.Windows"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 ThemeMode="System" Title="PhotoTrail Windows · 阶段3—6开发测试版" Width="1120" Height="760" MinWidth="720" MinHeight="480"
 PreviewKeyDown="WindowKeyDown" Loaded="WindowLoaded" Closing="WindowClosing" Closed="WindowClosed" AllowDrop="True" Drop="FilesDropped">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
   <TextBlock Text="PhotoTrail" FontSize="26" FontWeight="SemiBold" />
   <TextBlock Text="Windows 开发测试版 · 精确来源字段／成组日期／备份恢复／地图／重命名" Margin="0,4,0,10" />
   <WrapPanel>
    <Button x:Name="ReadButton" Content="导入照片" ToolTip="导入照片 · Ctrl+O" AutomationProperties.AcceleratorKey="Ctrl+O" Padding="12,6" Click="ReadPhoto" />
    <Button x:Name="FolderButton" Content="导入文件夹" ToolTip="导入文件夹 · Ctrl+Shift+O" AutomationProperties.AcceleratorKey="Ctrl+Shift+O" Padding="12,6" Margin="8,0,0,0" Click="ReadFolder" />
    <Button x:Name="RereadPhotosButton" Content="重新读取所选照片" AutomationProperties.Name="重新读取所选照片，跳过草稿与未应用输入" Padding="8,6" Click="RereadPhotos"/>
    <Button x:Name="RemoveButton" Content="移除所选" Padding="12,6" Margin="8,0,0,0" Click="RemovePhotos" IsEnabled="False" />
    <Button x:Name="UndoRemoveButton" Content="撤销移除" Padding="12,6" Click="UndoRemovePhotos" IsEnabled="False" />
    <Button Content="取消任务" ToolTip="取消进行中的任务 · Esc" AutomationProperties.AcceleratorKey="Esc" Padding="12,6" Margin="8,0,0,0" Click="CancelRead" />
    <Button x:Name="UndoLastApplyButton" Content="撤销最近一次应用" Click="UndoLastApply" Padding="12,6" Margin="8,0,0,0" IsEnabled="False" ToolTip="恢复最近一批应用之前的完整草稿；不撤销保存文件。"/>
   </WrapPanel>
   <WrapPanel Margin="0,6,0,0">
    <TextBlock Text="保存模式：" VerticalAlignment="Center"/><ComboBox x:Name="SaveModeChoice" SelectedIndex="0" Width="190" SelectionChanged="SaveModeChanged" AutomationProperties.Name="保存模式，默认副本"><ComboBoxItem Content="副本（保留会话草稿）"/><ComboBoxItem Content="新建同目录XMP旁车"/><ComboBoxItem Content="原位保存（强制备份）"/></ComboBox>
    <Button Content="全部待保存…" Click="PrepareSaveAll" Padding="8,5" AutomationProperties.Name="全库全部待保存，不依赖选择或筛选"/>
    <Button Content="当前工作区待保存…" Click="PrepareSaveWorkspace" Padding="8,5" AutomationProperties.Name="全库当前工作区字段范围"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Top"><WrapPanel><CheckBox x:Name="ImportRecursive" Content="递归导入" IsChecked="True" Checked="ImportOptionsChanged" Unchecked="ImportOptionsChanged" Margin="0,0,12,0"/><CheckBox x:Name="ImportPair" Content="同目录JPG／RAW配对" IsChecked="True" Checked="ImportOptionsChanged" Unchecked="ImportOptionsChanged"/><Button x:Name="ImportPause" Content="暂停准备" IsEnabled="False" Click="PauseImport" AutomationProperties.Name="暂停或继续导入准备" Margin="12,0"/></WrapPanel><TextBlock x:Name="ImportProgress" Text="队列仅当前运行内保留；尚未准备的来源不进入写入范围。" TextWrapping="Wrap"/><ListBox x:Name="ImportPending" MaxHeight="72" DisplayMemberPath="Path" SelectionChanged="PrioritizeImport" AutomationProperties.Name="等待准备的照片；选中优先读取"/></StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="导入照片或拖入文件。原文件不会被修改。" TextWrapping="Wrap" Margin="0,10,0,0" />
  <TabControl x:Name="WorkspaceTabs" SelectionChanged="MapSelected">
   <TabItem Header="元数据">
    <Grid Margin="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
       <TextBlock Text="文件名搜索"/><TextBox x:Name="PhotoSearch" ToolTip="搜索文件名 · F3" AutomationProperties.AcceleratorKey="F3" MaxLength="256" AutomationProperties.Name="文件名搜索" TextChanged="PhotoViewChanged" Margin="0,4"/>
       <ComboBox x:Name="PhotoFilter" SelectedIndex="0" AutomationProperties.Name="照片筛选" SelectionChanged="PhotoViewChanged" Margin="0,0,0,4"><ComboBoxItem Content="全部照片"/><ComboBoxItem Content="有草稿"/><ComboBoxItem Content="无草稿"/><ComboBoxItem Content="有定位"/><ComboBoxItem Content="无定位"/></ComboBox>
       <ComboBox x:Name="PhotoSort" SelectedIndex="0" AutomationProperties.Name="照片排序" SelectionChanged="PhotoViewChanged"><ComboBoxItem Content="文件名升序"/><ComboBoxItem Content="文件名降序"/><ComboBoxItem Content="拍摄时间升序"/><ComboBoxItem Content="拍摄时间降序"/><ComboBoxItem Content="导入顺序"/><ComboBoxItem Content="导入顺序倒序"/></ComboBox>
       <TextBlock x:Name="PhotoSortStatus" TextWrapping="Wrap" FontSize="11" Margin="0,4"/>
       <TextBlock x:Name="PhotoCount" Text="显示0／总计0；草稿0" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
      <ListBox x:Name="Photos" SelectionMode="Extended" SelectionChanged="PhotoSelected" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name.Label}" FontWeight="Bold" TextWrapping="Wrap"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,6"><local:PhotoThumbnail Document="{Binding Document}" Height="80" Width="80" AutomationProperties.Name="照片列表缩略图"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding PairStatus}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
     <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="SelectionInfo" Text="请选择照片。Ctrl / Shift 可多选。" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TabControl Grid.Row="1" SelectionChanged="PhotoPreviewTabChanged">
       <TabItem Header="编辑草稿">
        <DockPanel>
         <WrapPanel x:Name="DraftActions" DockPanel.Dock="Bottom" Margin="10,6" IsEnabled="False"><Button x:Name="FieldApplyButton" Content="应用" Click="ApplyDraft" Padding="12,6"/><Button x:Name="ClearSelectedDraftButton" Content="清空所选全部草稿" Click="UndoDraft" Padding="12,6" Margin="8,0,0,0"/></WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel x:Name="Editor" Margin="10" IsEnabled="False">
          <TextBlock Text="只应用勾选字段。勾选并留空会清除该字段；混合值不自动应用。" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <CheckBox x:Name="AuthorApply" Content="作者 · 每行一项；项内换行用JSON字符串数组"/><TextBox x:Name="AuthorValue" AutomationProperties.Name="作者" AcceptsReturn="True" MinHeight="42" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="TitleApply" Content="标题 · x-default"/><TextBox x:Name="TitleValue" AutomationProperties.Name="标题" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="DescriptionApply" Content="说明 · x-default"/><TextBox x:Name="DescriptionValue" AutomationProperties.Name="说明" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="KeywordsApply" Content="关键词 · 每行一项；项内换行用JSON字符串数组"/><TextBox x:Name="KeywordsValue" AutomationProperties.Name="关键词" AcceptsReturn="True" MinHeight="42" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="RightsApply" Content="版权 · x-default"/><TextBox x:Name="RightsValue" AutomationProperties.Name="版权" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="RatingApply" Content="评分 · 0至5，-1拒绝，留空清除"/><TextBox x:Name="RatingValue" AutomationProperties.Name="评分" MaxLength="2" TextChanged="EditorChanged" Visibility="Collapsed"/><ComboBox IsEditable="True" IsEnabled="{Binding ElementName=RatingValue, Path=IsEnabled}" Text="{Binding ElementName=RatingValue, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Rating枚举选择或原始值"><ComboBoxItem Content=""/><ComboBoxItem Content="-1"/><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox>
          <CheckBox x:Name="LabelApply" Content="标签 · 自定义文字"/><TextBox x:Name="LabelValue" AutomationProperties.Name="标签" MaxLength="256" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="DateApply" Content="XMP 拍摄时间"/><TextBox x:Name="DateValue" AutomationProperties.Name="拍摄时间" TextChanged="EditorChanged" Margin="0,4,0,4"/>
          <TextBlock Text="格式：yyyy:MM:dd HH:mm:ss，可附小数秒及Z/±hh:mm；不改 EXIF / IPTC。" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <CheckBox x:Name="DigitizedApply" Content="XMP 数字化时间"/><TextBox x:Name="DigitizedValue" AutomationProperties.Name="数字化时间 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="CreateDateApply" Content="XMP 创建时间"/><TextBox x:Name="CreateDateValue" AutomationProperties.Name="创建时间 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <CheckBox x:Name="ModifyDateApply" Content="XMP 修改时间"/><TextBox x:Name="ModifyDateValue" AutomationProperties.Name="修改时间 · XMP" TextChanged="EditorChanged" Margin="0,4,0,10"/>
          <TextBlock Text="四个XMP日期独立。旁车主时间为XMP创建时间；无旁车JPEG主时间为下方成组EXIF拍摄时间。" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <TextBlock Text="EXIF 精确来源 · 仅无旁车JPEG；与XMP同义字段独立" TextWrapping="Wrap"/>
<TextBlock Text="R04c 精确EXIF数值／IPTC部分日期／原图系统时间；仅无旁车JPEG" TextWrapping="Wrap"/>
<CheckBox x:Name="ExifExposureTimeApply" Content="ExifIFD:ExposureTime · 秒 0.000001—86400"/><TextBox x:Name="ExifExposureTimeValue" AutomationProperties.Name="ExifIFD:ExposureTime" ToolTip="秒 0.000001—86400；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifShutterApply" Content="ExifIFD:ShutterSpeedValue · 秒 0.000001—86400；存储APEX"/><TextBox x:Name="ExifShutterValue" AutomationProperties.Name="ExifIFD:ShutterSpeedValue" ToolTip="秒 0.000001—86400；存储APEX；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifFNumberApply" Content="ExifIFD:FNumber · f数 0.1—128"/><TextBox x:Name="ExifFNumberValue" AutomationProperties.Name="ExifIFD:FNumber" ToolTip="f数 0.1—128；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifApertureApply" Content="ExifIFD:ApertureValue · f数 1—128；存储APEX"/><TextBox x:Name="ExifApertureValue" AutomationProperties.Name="ExifIFD:ApertureValue" ToolTip="f数 1—128；存储APEX；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifMaxApertureApply" Content="ExifIFD:MaxApertureValue · f数 1—128；存储APEX"/><TextBox x:Name="ExifMaxApertureValue" AutomationProperties.Name="ExifIFD:MaxApertureValue" ToolTip="f数 1—128；存储APEX；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifIsoApply" Content="ExifIFD:ISO · 整数1—65535"/><TextBox x:Name="ExifIsoValue" AutomationProperties.Name="ExifIFD:ISO" ToolTip="整数1—65535；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifFocalApply" Content="ExifIFD:FocalLength · 毫米0.1—10000"/><TextBox x:Name="ExifFocalValue" AutomationProperties.Name="ExifIFD:FocalLength" ToolTip="毫米0.1—10000；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifFocal35Apply" Content="ExifIFD:FocalLengthIn35mmFormat · 整数0—65535"/><TextBox x:Name="ExifFocal35Value" AutomationProperties.Name="ExifIFD:FocalLengthIn35mmFormat" ToolTip="整数0—65535；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifBiasApply" Content="ExifIFD:ExposureCompensation · EV -100—100"/><TextBox x:Name="ExifBiasValue" AutomationProperties.Name="ExifIFD:ExposureCompensation" ToolTip="EV -100—100；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifFlashApply" Content="ExifIFD:Flash · 整数0—127；原始位组合：0触发／1—2返回／3—4模式／5无功能／6防红眼，不猜未知原值"/><TextBox x:Name="ExifFlashValue" AutomationProperties.Name="ExifIFD:Flash" ToolTip="整数0—127；原始位组合：0触发／1—2返回／3—4模式／5无功能／6防红眼，不猜未知原值；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifColorApply" Content="ExifIFD:ColorSpace · 仅1／65535"/><TextBox x:Name="ExifColorValue" AutomationProperties.Name="ExifIFD:ColorSpace" ToolTip="仅1／65535；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifModeApply" Content="ExifIFD:ExposureMode · 整数0—2"/><TextBox x:Name="ExifModeValue" AutomationProperties.Name="ExifIFD:ExposureMode" ToolTip="整数0—2；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifProgramApply" Content="ExifIFD:ExposureProgram · 整数0—8"/><TextBox x:Name="ExifProgramValue" AutomationProperties.Name="ExifIFD:ExposureProgram" ToolTip="整数0—8；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifMeterApply" Content="ExifIFD:MeteringMode · 仅0／1／2／3／4／5／6／255"/><TextBox x:Name="ExifMeterValue" AutomationProperties.Name="ExifIFD:MeteringMode" ToolTip="仅0／1／2／3／4／5／6／255；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifWhiteApply" Content="ExifIFD:WhiteBalance · 整数0—1"/><TextBox x:Name="ExifWhiteValue" AutomationProperties.Name="ExifIFD:WhiteBalance" ToolTip="整数0—1；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifSaturationApply" Content="ExifIFD:Saturation · 整数0—2"/><TextBox x:Name="ExifSaturationValue" AutomationProperties.Name="ExifIFD:Saturation" ToolTip="整数0—2；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifSharpnessApply" Content="ExifIFD:Sharpness · 整数0—2"/><TextBox x:Name="ExifSharpnessValue" AutomationProperties.Name="ExifIFD:Sharpness" ToolTip="整数0—2；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifOrientationApply" Content="IFD0:Orientation · 整数1—8；仅改标签不旋转像素"/><TextBox x:Name="ExifOrientationValue" AutomationProperties.Name="IFD0:Orientation" ToolTip="整数1—8；仅改标签不旋转像素；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifXResApply" Content="IFD0:XResolution · 0.000001—1000000"/><TextBox x:Name="ExifXResValue" AutomationProperties.Name="IFD0:XResolution" ToolTip="0.000001—1000000；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifYResApply" Content="IFD0:YResolution · 0.000001—1000000"/><TextBox x:Name="ExifYResValue" AutomationProperties.Name="IFD0:YResolution" ToolTip="0.000001—1000000；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="ExifResUnitApply" Content="IFD0:ResolutionUnit · 整数1—3"/><TextBox x:Name="ExifResUnitValue" AutomationProperties.Name="IFD0:ResolutionUnit" ToolTip="整数1—3；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="IptcDateApply" Content="IPTC:DateCreated · yyyy:MM:dd；严格公历"/><TextBox x:Name="IptcDateValue" AutomationProperties.Name="IPTC:DateCreated" ToolTip="yyyy:MM:dd；严格公历；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="IptcTimeApply" Content="IPTC:TimeCreated · HH:mm:ssZ／±hh:mm；明确偏移"/><TextBox x:Name="IptcTimeValue" AutomationProperties.Name="IPTC:TimeCreated" ToolTip="HH:mm:ssZ／±hh:mm；明确偏移；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="SystemCreateApply" Content="System:FileCreateDate · 完整时间；无偏移使用本机时区；100ns；不可清除"/><TextBox x:Name="SystemCreateValue" AutomationProperties.Name="System:FileCreateDate" ToolTip="完整时间；无偏移使用本机时区；100ns；不可清除；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="SystemModifyApply" Content="System:FileModifyDate · 完整时间；无偏移使用本机时区；100ns；不可清除"/><TextBox x:Name="SystemModifyValue" AutomationProperties.Name="System:FileModifyDate" ToolTip="完整时间；无偏移使用本机时区；100ns；不可清除；未勾选保持；EXIF/IPTC勾选留空清除，系统时间空值拒绝。" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<TextBlock Text="IPTC 精确图内来源 · 设置须明确UTF8；勾选留空为清除" TextWrapping="Wrap"/>
<CheckBox x:Name="IptcBylineApply" Content="IPTC:By-line · 32 UTF8字节"/><TextBox x:Name="IptcBylineValue" AutomationProperties.Name="IPTC:By-line" ToolTip="列表：每行一项；元素内部换行用JSON字符串数组。不截断、不自动trim；编码未知时仅可尝试明确清除并核对原始剩余数据集。" AcceptsReturn="True" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="IptcBylineTitleApply" Content="IPTC:By-lineTitle · 32 UTF8字节"/><TextBox x:Name="IptcBylineTitleValue" AutomationProperties.Name="IPTC:By-lineTitle" ToolTip="列表：每行一项；元素内部换行用JSON字符串数组。不截断、不自动trim；编码未知时仅可尝试明确清除并核对原始剩余数据集。" AcceptsReturn="True" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="IptcContactApply" Content="IPTC:Contact · 128 UTF8字节"/><TextBox x:Name="IptcContactValue" AutomationProperties.Name="IPTC:Contact" ToolTip="列表：每行一项；元素内部换行用JSON字符串数组。不截断、不自动trim；编码未知时仅可尝试明确清除并核对原始剩余数据集。" AcceptsReturn="True" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="IptcKeywordsApply" Content="IPTC:Keywords · 64 UTF8字节"/><TextBox x:Name="IptcKeywordsValue" AutomationProperties.Name="IPTC:Keywords" ToolTip="列表：每行一项；元素内部换行用JSON字符串数组。不截断、不自动trim；编码未知时仅可尝试明确清除并核对原始剩余数据集。" AcceptsReturn="True" TextChanged="EditorChanged" Margin="0,4,0,10"/>
<CheckBox x:Name="IptcHeadlineApply" Content="IPTC:Headline · 256 UTF8字节"/><TextBox x:Name="IptcHeadlineValue" AutomationProperties.Name="IPTC:Headline" ToolTip="不截断、不自动trim；编码未知时仅可尝试明确清除并核对原始剩余数据集。" AcceptsReturn="True" TextChanged="EditorChanged" Margin="0,4,0,10"/>
