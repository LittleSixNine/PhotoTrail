         <TextBlock Text="时" VerticalAlignment="Center" />
         <TextBox x:Name="DateReplaceHour" Width="60" Margin="4" MaxLength="8" AutomationProperties.Name="替换时" TextChanged="DatePlanChanged" />
         <TextBlock Text="分" VerticalAlignment="Center" />
         <TextBox x:Name="DateReplaceMinute" Width="60" Margin="4" MaxLength="8" AutomationProperties.Name="替换分" TextChanged="DatePlanChanged" />
         <TextBlock Text="秒" VerticalAlignment="Center" />
         <TextBox x:Name="DateReplaceSecond" Width="60" Margin="4" MaxLength="8" AutomationProperties.Name="替换秒" TextChanged="DatePlanChanged" />
        </WrapPanel>
       </StackPanel>
       <StackPanel x:Name="DateStartOptions" Visibility="Collapsed">
        <TextBlock Text="序列/分布起点（yyyy:MM:dd HH:mm:ss，可附小数秒及Z/±hh:mm）" TextWrapping="Wrap" />
        <TextBox x:Name="DateStart" AutomationProperties.Name="日期序列起点" TextChanged="DatePlanChanged" Margin="0,4" />
       </StackPanel>
       <DockPanel x:Name="DateSequenceOptions" Visibility="Collapsed" Margin="0,4">
        <TextBlock Text="序列间隔秒" DockPanel.Dock="Left" VerticalAlignment="Center" />
        <TextBox x:Name="DateStep" Text="1" Width="100" HorizontalAlignment="Left" Margin="8,0" AutomationProperties.Name="日期序列间隔秒" TextChanged="DatePlanChanged" />
       </DockPanel>
       <StackPanel x:Name="DateDistributionOptions" Visibility="Collapsed">
        <TextBlock Text="分布终点（起止小数秒/时区须完全相同；按最近整秒分配，可出现相同时间；单张采用起点）" TextWrapping="Wrap" />
        <TextBox x:Name="DateEnd" AutomationProperties.Name="日期分布终点" TextChanged="DatePlanChanged" Margin="0,4" />
       </StackPanel>
       <StackPanel x:Name="DateFilenameOptions" Visibility="Collapsed">
        <TextBlock Text="文件名日期正则（最多1024字；普通捕获组，不支持前后查找/反向引用）" TextWrapping="Wrap" />
        <TextBox x:Name="DateFilenamePattern" Text="([0-9]{4})([0-9]{2})([0-9]{2})_([0-9]{2})([0-9]{2})([0-9]{2})" MaxLength="1024" AutomationProperties.Name="文件名日期正则" TextChanged="DatePlanChanged" Margin="0,4" />
        <TextBlock Text="日期模板（$1等捕获组；不匹配/非法日期逐项跳过，不猜测当前时间或时区）" TextWrapping="Wrap" />
        <TextBox x:Name="DateFilenameTemplate" Text="$1:$2:$3 $4:$5:$6" MaxLength="512" AutomationProperties.Name="文件名日期模板" TextChanged="DatePlanChanged" Margin="0,4" />
       </StackPanel>
       <WrapPanel Margin="0,8">
        <Button x:Name="DatePlanApplyButton" Content="应用" Click="ApplyDates" IsEnabled="False" Padding="10,5" Margin="8,0" />
        <Button Content="取消应用" Click="CancelRead" Padding="10,5" />
       </WrapPanel>
       <TextBlock Text="缺失/非法日期不会猜测；闰日或31日调整落入非法日期会拒绝。无时区保持无时区，小数秒和固定偏移原样保留；不处理时区夏令时切换。" TextWrapping="Wrap" Margin="0,0,0,8" />
       <TextBlock x:Name="DatePlanPreview" Text="设置参数后应用；只加入待保存草稿。" TextWrapping="Wrap" />
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="XMP交换">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="10">
       <TextBlock Text="磁盘快照不含未保存草稿；含草稿导出在隔离副本构造。两者保留其他XMP语言／字段，不把EXIF/IPTC/System转换到XMP，目标不覆盖。" TextWrapping="Wrap" />
       <Button Content="导出磁盘XMP快照…" Click="ExportDiskXmp" HorizontalAlignment="Left" Padding="10,6" Margin="0,8" />
       <Button Content="导出含草稿XMP…" Click="ExportXmp" HorizontalAlignment="Left" Padding="10,6" Margin="0,8" />
       <TextBlock Text="导入XMP仅载入CSV交换已开放的XMP精确字段到编辑区，缺失字段不清除。GPS、其他语言及其他字段只提示未导入，不自动写照片。" TextWrapping="Wrap" Margin="0,8" />
       <DockPanel>
        <Button Content="选择…" DockPanel.Dock="Right" Click="ChooseXmp" Padding="10,5" Margin="8,0,0,0" />
        <TextBox x:Name="XmpPath" AutomationProperties.Name="XMP字段来源" />
       </DockPanel>
       <Button Content="载入XMP字段到编辑区" Click="ImportXmp" HorizontalAlignment="Left" Padding="10,6" Margin="0,8" />
       <TextBlock Text="XMP上限8MiB／64层，拒绝DTD/外部实体及非法字段，全部验证后才填入。核对勾选字段再加入草稿，最后保存副本。" TextWrapping="Wrap" />
       <TextBlock x:Name="XmpPreview" Text="尚未载入。" TextWrapping="Wrap" Margin="0,10" />
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem x:Name="ComparisonTab" Header="比较与交换">
     <DockPanel Margin="8">
      <TextBlock x:Name="ComparisonStatus" DockPanel.Dock="Top" TextWrapping="Wrap" />
      <DataGrid x:Name="ComparisonGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" AutoGeneratingColumn="ComparisonColumn" EnableRowVirtualization="True" EnableColumnVirtualization="True" />
     </DockPanel>
    </TabItem>
    <TabItem x:Name="PhotoPreviewTab" Header="照片预览">
     <DockPanel Margin="8">
      <TextBlock x:Name="PhotoPreviewStatus" DockPanel.Dock="Bottom" Text="请选择单张照片。JPEG/PNG/TIFF用本机解码，RAW用合法内嵌JPEG；不改照片。" TextWrapping="Wrap" Margin="0,8,0,0" />
      <Image x:Name="PhotoPreviewImage" Stretch="Uniform" AutomationProperties.Name="所选照片预览" />
     </DockPanel>
    </TabItem>
    <TabItem x:Name="SaveTargetTab" Header="保存摘要">
     <DockPanel Margin="8">
      <StackPanel DockPanel.Dock="Top">
       <TextBlock Text="{DynamicResource M1.SaveLocation}" />
       <DockPanel x:Name="SaveLocationHost">
        <Button x:Name="OutputButton" Content="选择…" Click="ChooseOutput" Padding="10,4" Margin="3" DockPanel.Dock="Right" />
        <TextBox x:Name="OutputFolder" AutomationProperties.Name="输出文件夹" VerticalContentAlignment="Center" Margin="3" />
       </DockPanel>
       <WrapPanel x:Name="SaveOptionsHost">
        <ComboBox x:Name="SaveModeChoice" SelectedIndex="0" Width="190" SelectionChanged="SaveModeChanged" AutomationProperties.Name="保存模式，默认副本" Margin="3">
         <ComboBoxItem Content="副本（保留会话草稿）" />
         <ComboBoxItem Content="新建同目录XMP旁车" />
         <ComboBoxItem Content="原位保存（强制备份）" />
        </ComboBox>
       </WrapPanel>
      </StackPanel>
      <WrapPanel DockPanel.Dock="Top">
       <Button x:Name="ExecuteSaveButton" Content="确认执行冻结计划" Click="ExecuteSavePlan" IsEnabled="False" Padding="12,6" />
       <Button Content="取消保存计划（不写文件）" Click="CancelSavePlan" Padding="12,6" />
      </WrapPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
       <TextBlock Text="原位备份目录（必须已存在；不自动清理）：" />
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="选择备份目录" Click="ChooseBackup" />
        <TextBox x:Name="BackupFolder" AutomationProperties.Name="原位备份目录" LostFocus="BackupChanged" />
       </DockPanel>
       <TextBlock Text="保存／恢复记录（启动仅发现，不修改磁盘）：" />
       <ComboBox x:Name="InplaceRecords" DisplayMemberPath="Label" AutomationProperties.Name="选择按记录恢复的事务" />
       <WrapPanel>
        <Button Content="核对记录摘要" Click="ShowInplaceRecord" />
        <Button Content="确认核对并接纳结果" Click="CheckInplaceRecord" />
        <Button Content="按所选记录恢复" Click="RestoreInplaceRecord" />
       </WrapPanel>
       <TextBlock x:Name="InplaceStatus" TextWrapping="Wrap" />
      </StackPanel>
      <TextBox x:Name="SaveSummary" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="保存目标、范围、逐文件结果" Text="尚未准备保存计划。默认副本；原位必须先备份。" />
     </DockPanel>
    </TabItem>
    <TabItem Header="CSV">
     <DockPanel Margin="12">
      <StackPanel DockPanel.Dock="Top">
       <TextBlock Text="CSV · 沿用元数据页当前选择" FontSize="20" FontWeight="SemiBold" />
       <TextBlock Text="回导CSV的值使用JSON字符串或列表；空单元不修改，@clear明确清除。只匹配当前选择的身份与相对路径，跨电脑路径改变后不能直接匹配。" TextWrapping="Wrap" Margin="0,8" />
       <WrapPanel>
        <Button Content="导出回导CSV…" Click="ExportRoundtripCsv" Padding="10,6" />
        <Button Content="导出显示CSV…" Click="ExportDisplayCsv" Padding="10,6" Margin="8,0" />
       </WrapPanel>
       <TextBlock Text="导入文件" Margin="0,12,0,4" />
       <DockPanel>
        <Button Content="选择…" DockPanel.Dock="Right" Click="ChooseCsv" Padding="10,5" Margin="8,0,0,0" />
        <TextBox x:Name="CsvPath" AutomationProperties.Name="CSV导入文件" TextChanged="CsvChanged" />
       </DockPanel>
       <WrapPanel Margin="0,8">
        <Button x:Name="CsvApplyButton" Content="应用" Click="ApplyCsv" IsEnabled="False" Padding="10,6" Margin="8,0" />
       </WrapPanel>
       <TextBlock Text="应用只加入待保存草稿，可撤销；保存副本才写入文件，不覆盖已有文件。显示CSV有公式防护，不能回导；Google查询结果不导出。" TextWrapping="Wrap" Margin="0,0,0,8" />
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <TextBlock x:Name="CsvPreview" Text="设置参数后应用；只加入待保存草稿。" TextWrapping="Wrap" />
      </ScrollViewer>
     </DockPanel>
    </TabItem>
   </TabControl>
  </Grid>
  <TabControl x:Name="SettingsPages" Visibility="Collapsed">
   <TabItem Header="地图设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="16" MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Text="运行环境" FontSize="20" FontWeight="SemiBold" />
      <CheckBox x:Name="RecordMapSearches" Content="记录最近搜索" IsChecked="True" Checked="MetadataSettingChanged" Unchecked="MetadataSettingChanged" Margin="0,10,0,6" />
      <Button x:Name="ClearSearchHistoryButton" Content="清除最近搜索记录" Click="ClearSearchHistory" HorizontalAlignment="Left" Padding="10,5" />
      <TextBlock x:Name="SearchHistoryStatus" Text="默认最多记录3条；关闭隐藏并停止新增，重新开启恢复。清除只删除历史内容。" TextWrapping="Wrap" Margin="0,6,0,12" />
      <Button x:Name="EnvironmentCheckButton" Content="检查本机环境" Click="CheckDependencies" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,8" />
      <TextBlock x:Name="DependencyStatus" Text="可检查.NET、WebView2与ExifTool；只读取本机环境。" TextWrapping="Wrap" Margin="0,0,0,14" />
      <TextBlock Text="Google Maps 自备密钥" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="默认地图仍为免费的OpenFreeMap，无需密钥。保存密钥后可明确选择Google地图；仅当前会话使用，重启默认回到OpenFreeMap。" TextWrapping="Wrap" Margin="0,10,0,10" />
      <TextBlock Text="使用Google服务需自行配置项目、相应API及计费，并设置密钥限制与配额；保存密钥不代表验证成功，也不会产生Google请求。" TextWrapping="Wrap" Margin="0,0,0,14" />
      <Label Content="Google API密钥" Target="{Binding ElementName=GoogleKeyInput}" />
      <PasswordBox x:Name="GoogleKeyInput" AutomationProperties.Name="Google API密钥" MaxLength="256" Width="420" HorizontalAlignment="Left" />
      <WrapPanel Margin="0,12,0,12">
       <Button Content="保存本机密钥" Click="SaveGoogleKey" Padding="12,6" />
       <Button Content="删除本机密钥" Click="ClearGoogleKey" Padding="12,6" Margin="8,0,0,0" />
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
       <Button Content="使用Google地图（联网）" Click="UseGoogleMap" Padding="12,6" />
       <Button Content="使用默认地图" Click="UseDefaultMap" Padding="12,6" Margin="8,0,0,0" />
      </WrapPanel>
      <TextBlock Text="Google使用时密钥会交给网页SDK并随请求发送，DPAPI仅保护本机存储。HTTP来源限制应匹配https://phototrail.local/*；启用Maps JavaScript API与Geocoding API。地区结果当前只预览，不自动保存。" TextWrapping="Wrap" Margin="0,0,0,12" />
      <TextBlock x:Name="GoogleKeyStatus" Text="尚未保存本机密钥。" TextWrapping="Wrap" />
      <TextBlock Text="密钥以Windows当前用户保护的数据保存；不会回显、进入项目源码或开发日志。更换电脑/用户后请重新输入。同一Windows用户运行的程序仍可能访问它；它不能替代Google的密钥限制。" TextWrapping="Wrap" Margin="0,16,0,0" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="应用设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="16">
      <Button x:Name="FolderButton" Content="导入文件夹" ToolTip="导入文件夹 · Ctrl+Shift+O" AutomationProperties.AcceleratorKey="Ctrl+Shift+O" Padding="12,6" Margin="3" Click="ReadFolder" />
      <CheckBox x:Name="ImportRecursive" Content="递归导入" IsChecked="True" Checked="ImportOptionsChanged" Unchecked="ImportOptionsChanged" Margin="3" />
      <CheckBox x:Name="ImportPair" Content="同目录JPG／RAW配对" IsChecked="True" Checked="ImportOptionsChanged" Unchecked="ImportOptionsChanged" Margin="3" />
      <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="默认跟随Windows系统；更改后保存本机外观偏好，重启恢复。" TextWrapping="Wrap" Margin="0,8" />
      <ComboBox x:Name="ThemeChoice" Width="220" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="ThemeChanged" AutomationProperties.Name="应用外观">
       <ComboBoxItem Content="跟随系统" />
       <ComboBoxItem Content="浅色" />
       <ComboBoxItem Content="深色" />
      </ComboBox>
      <TextBlock x:Name="ThemeStatus" Text="默认跟随Windows系统外观；不改变系统设置。" TextWrapping="Wrap" Margin="0,8" />
      <TextBlock Text="常用字段配置" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8" />
      <TextBox x:Name="CommonFieldSearch" AutomationProperties.Name="搜索常用字段名称或技术标签" TextChanged="CommonFieldSearchChanged" />
      <WrapPanel>
       <Button Content="恢复默认24项" Click="RestoreCommonFields" Padding="8,4" />
       <Button Content="清空常用字段" Click="ClearCommonFields" Padding="8,4" />
      </WrapPanel>
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
       <ItemsControl x:Name="CommonFieldOptions">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <CheckBox Content="{Binding Label}" Tag="{Binding Tag}" IsChecked="{Binding Selected,Mode=OneWay}" Checked="CommonFieldToggled" Unchecked="CommonFieldToggled" AutomationProperties.Name="{Binding Label}" Margin="2,4" />
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <TextBlock Text="元数据显示" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8" />
      <Label Content="文字大小" Target="{Binding ElementName=MetadataTextSize}" />
      <ComboBox x:Name="MetadataTextSize" Width="220" HorizontalAlignment="Left" SelectedIndex="1" AutomationProperties.Name="元数据文字大小" SelectionChanged="MetadataSettingChanged">
       <ComboBoxItem Content="小（-2 pt）" />
       <ComboBoxItem Content="标准" />
       <ComboBoxItem Content="大（+2 pt）" />
      </ComboBox>
      <Label Content="行间距" Target="{Binding ElementName=MetadataSpacing}" />
      <ComboBox x:Name="MetadataSpacing" Width="220" HorizontalAlignment="Left" SelectedIndex="1" AutomationProperties.Name="元数据行间距" SelectionChanged="MetadataSettingChanged">
       <ComboBoxItem Content="紧凑" />
       <ComboBoxItem Content="标准" />
       <ComboBoxItem Content="宽松" />
      </ComboBox>
      <CheckBox x:Name="FullTagNames" Content="显示完整标签名称" IsChecked="True" Checked="MetadataSettingChanged" Unchecked="MetadataSettingChanged" Margin="0,12,0,8" />
      <TextBlock Text="关闭后保留来源家族；完整名称继续用于提示、辅助技术、搜索与复制。" TextWrapping="Wrap" />
      <Button Content="恢复显示、排序与搜索开关默认值" Click="ResetSettings" HorizontalAlignment="Left" Padding="12,6" Margin="0,14,0,8" />
      <TextBlock x:Name="SettingsStatus" Text="文字大小和行间距独立；默认标准，即时生效并保存本机。" TextWrapping="Wrap" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
</Window>