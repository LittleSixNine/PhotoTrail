         <WrapPanel Margin="0,8"><Button x:Name="PresetApplyButton" Content="一次应用操作链到所选草稿" Click="ApplyPreset"/><Button Content="撤销最近一次应用" Click="UndoLastApply"/></WrapPanel>
         <TextBlock x:Name="PresetPreview" Text="尚未编排操作。" TextWrapping="Wrap"/>
