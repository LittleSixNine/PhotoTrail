<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:PhotoTrail.Windows" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PhotoTrail.Windows.MainWindow" ThemeMode="System" Title="PhotoTrail Windows · WIN-M1" Width="1193" Height="736" MinWidth="720" MinHeight="480" PreviewKeyDown="WindowKeyDown" Loaded="WindowLoaded" Closing="WindowClosing" Closed="WindowClosed" AllowDrop="True" Drop="FilesDropped" FontSize="13">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Resources/M1Strings.xaml" />
   </ResourceDictionary.MergedDictionaries>
   <Style TargetType="Button">
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Margin" Value="2" />
   </Style>
   <Style x:Key="M1.Primary" TargetType="Button">
    <Setter Property="Background" Value="#087EF5" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="3" />
   </Style>
   <Style x:Key="M1.Navigation" TargetType="RadioButton">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="RadioButton">
       <Border x:Name="NavBorder" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
         <Setter TargetName="NavBorder" Property="Background" Value="#087EF5" />
         <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
         <Setter TargetName="NavBorder" Property="BorderThickness" Value="2" />
         <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        </Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <Grid x:Name="M1Toolbar" Margin="12,7" SizeChanged="M1ToolbarSized">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
   <TextBlock Text="PhotoTrail" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
    <RadioButton x:Name="MetadataNavigation" Tag="0" GroupName="Workspaces" IsChecked="True" Style="{StaticResource M1.Navigation}" Checked="M1WorkspaceSelected" Content="{DynamicResource M1.MetadataNav}" />
    <RadioButton x:Name="MapNavigation" Tag="1" GroupName="Workspaces" Style="{StaticResource M1.Navigation}" Checked="M1WorkspaceSelected" Content="{DynamicResource M1.MapNav}" />
    <RadioButton x:Name="RenameNavigation" Tag="2" GroupName="Workspaces" Style="{StaticResource M1.Navigation}" Checked="M1WorkspaceSelected" Content="{DynamicResource M1.RenameNav}" />
   </StackPanel>
   <WrapPanel x:Name="M1TopActions" Grid.Column="2" HorizontalAlignment="Right">
    <Button x:Name="SaveButton" Content="{DynamicResource M1.SaveSelected}" ToolTip="保存所选草稿为副本 · Ctrl+S" AutomationProperties.AcceleratorKey="Ctrl+S" Click="SaveCopies" Padding="12,6" HorizontalAlignment="Left" IsEnabled="False" Margin="3" Style="{StaticResource M1.Primary}" />
    <Button x:Name="ReadButton" Content="{DynamicResource M1.Import}" ToolTip="导入照片 · Ctrl+O" AutomationProperties.AcceleratorKey="Ctrl+O" Padding="12,6" Click="ReadPhoto" Margin="3" />
    <Button x:Name="M1MoreButton" Content="{DynamicResource M1.More}" Click="M1ShowMore" />
    <Button Content="{DynamicResource M1.Settings}" Click="M1OpenSettings" AutomationProperties.Name="{DynamicResource M1.Settings}" />
   </WrapPanel>
  </Grid>
  <DockPanel x:Name="M1TaskPanel" Grid.Row="1" Margin="12,0,12,5" Visibility="Collapsed">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="M1TaskActions">
    <Button x:Name="ImportPause" Content="暂停准备" IsEnabled="False" Click="PauseImport" AutomationProperties.Name="暂停或继续导入准备" Margin="3" />
    <Button Content="{DynamicResource M1.CancelTask}" Click="CancelRead" />
   </StackPanel>
   <StackPanel x:Name="M1TaskInformation">
    <TextBlock x:Name="ImportProgress" Text="队列仅当前运行内保留；尚未准备的来源不进入写入范围。" TextWrapping="Wrap" Margin="3" />
    <ListBox x:Name="ImportPending" MaxHeight="72" DisplayMemberPath="Path" SelectionChanged="PrioritizeImport" AutomationProperties.Name="等待准备的照片；选中优先读取" Margin="3" />
   </StackPanel>
  </DockPanel>
  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="64" HorizontalScrollBarVisibility="Disabled" x:Name="M1StatusHost">
   <TextBlock x:Name="Status" Text="导入照片或拖入文件。原文件不会被修改。" TextWrapping="Wrap" Margin="3" />
  </ScrollViewer>
  <TabControl x:Name="WorkspaceTabs" SelectedIndex="0" SelectionChanged="MapSelected" Grid.Row="2" BorderThickness="0" Padding="0">
   <TabControl.Template>
    <ControlTemplate TargetType="TabControl">
     <Grid>
      <TabPanel IsItemsHost="True" Visibility="Collapsed" />
      <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
     </Grid>
    </ControlTemplate>
   </TabControl.Template>
   <TabItem Header="元数据编辑">
    <Grid x:Name="M1MetadataLayout">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="280" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" MinWidth="280" />
     </Grid.ColumnDefinitions>
     <DockPanel>
      <DockPanel x:Name="M1PhotoSidebar" DockPanel.Dock="Right" Width="190" Visibility="Collapsed" Margin="5,0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
       <TextBlock DockPanel.Dock="Top" Text="{DynamicResource M1.PhotoActions}" FontWeight="SemiBold" Margin="10" />
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="M1PhotoActions" Margin="8">
         <Button Content="{DynamicResource M1.Favorite}" Click="M1OpenFavorites" />
         <Button Content="{DynamicResource M1.TrackMatch}" Click="M1OpenTrackMatch" />
         <Button Content="{DynamicResource M1.AdjustDate}" Tag="批量日期" Click="M1OpenTool" />
         <Button Content="{DynamicResource M1.PhotoGpx}" Click="PreviewPhotoGpx" />
         <Button Content="{DynamicResource M1.GpsCopy}" Click="M1PrepareGpsCopy" />
         <TextBlock Text="{DynamicResource M1.GpsClearLimit}" TextWrapping="Wrap" Margin="3,9" />
         <Button Content="{DynamicResource M1.ClearDraft}" Click="UndoDraft" />
         <Button x:Name="RereadPhotosButton" Content="重新读取所选照片" AutomationProperties.Name="重新读取所选照片，跳过草稿与未应用输入" Padding="8,6" Click="RereadPhotos" Margin="3" />
         <Button x:Name="RemoveButton" Content="移除所选" Padding="12,6" Margin="3" Click="RemovePhotos" IsEnabled="False" />
         <Button x:Name="UndoRemoveButton" Content="撤销移除" Padding="12,6" Click="UndoRemovePhotos" IsEnabled="False" Margin="3" />
         <Button x:Name="UndoLastApplyButton" Content="撤销最近一次应用" Click="UndoLastApply" Padding="12,6" Margin="3" IsEnabled="False" ToolTip="恢复最近一批应用之前的完整草稿；不撤销保存文件。" />
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
      <DockPanel Margin="10,3,4,0">
       <StackPanel DockPanel.Dock="Top">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="122" />
          <ColumnDefinition Width="112" />
         </Grid.ColumnDefinitions>
         <Grid x:Name="M1PhotoSearchBox">
          <TextBox x:Name="PhotoSearch" AutomationProperties.Name="{DynamicResource M1.PhotoSearch}" ToolTip="{DynamicResource M1.PhotoSearch}" TextChanged="PhotoViewChanged" MaxLength="256" Margin="0,3,5,3" />
          <TextBlock Text="{DynamicResource M1.PhotoSearch}" IsHitTestVisible="False" Opacity="0.55" Margin="9,0" VerticalAlignment="Center">
           <TextBlock.Style>
            <Style TargetType="TextBlock">
             <Setter Property="Visibility" Value="Collapsed" />
             <Style.Triggers>
              <DataTrigger Binding="{Binding ElementName=PhotoSearch,Path=Text}" Value="">
               <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
         </Grid>
         <ComboBox Grid.Column="1" x:Name="PhotoSort" SelectedIndex="0" SelectionChanged="PhotoViewChanged" AutomationProperties.Name="{DynamicResource M1.Sort}" Margin="0,3,5,3">
          <ComboBoxItem Content="文件名升序" />
          <ComboBoxItem Content="文件名降序" />
          <ComboBoxItem Content="拍摄时间升序" />
          <ComboBoxItem Content="拍摄时间降序" />
          <ComboBoxItem Content="导入顺序" />
          <ComboBoxItem Content="导入顺序倒序" />
         </ComboBox>
         <ComboBox Grid.Column="2" x:Name="PhotoFilter" SelectedIndex="0" SelectionChanged="PhotoViewChanged" AutomationProperties.Name="{DynamicResource M1.Filter}" Margin="0,3">
          <ComboBoxItem Content="全部照片" />
          <ComboBoxItem Content="有草稿" />
          <ComboBoxItem Content="无草稿" />
          <ComboBoxItem Content="有定位" />
          <ComboBoxItem Content="无定位" />
         </ComboBox>
        </Grid>
        <DockPanel Margin="0,6">
         <Button DockPanel.Dock="Right" Content="{DynamicResource M1.PhotoActions}" Click="M1TogglePhotoActions" />
         <TextBlock x:Name="M1SelectionCount" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <TextBlock x:Name="PhotoSortStatus" Visibility="Collapsed" />
       </StackPanel>
       <StackPanel DockPanel.Dock="Bottom" Margin="0,5">
        <TextBlock x:Name="PhotoCount" TextWrapping="Wrap" />
        <TextBlock x:Name="M1DraftCount" TextWrapping="Wrap" />
       </StackPanel>
       <Grid>
        <ListView x:Name="Photos" SelectionMode="Extended" SelectionChanged="PhotoSelected" SizeChanged="M1PhotoTableSized" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{DynamicResource M1.PhotoTable}">
         <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
           <Setter Property="HorizontalContentAlignment" Value="Stretch" />
           <Setter Property="MinHeight" Value="48" />
           <Setter Property="ToolTip" Value="{Binding Summary}" />
          </Style>
         </ListView.ItemContainerStyle>
         <ListView.GroupStyle>
          <GroupStyle>
           <GroupStyle.HeaderTemplate>
            <DataTemplate>
             <TextBlock Text="{Binding Name.Label}" FontWeight="SemiBold">
              <TextBlock.Style>
               <Style TargetType="TextBlock">
                <Style.Triggers>
                 <DataTrigger Binding="{Binding Name.Label}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                 </DataTrigger>
                </Style.Triggers>
               </Style>
              </TextBlock.Style>
             </TextBlock>
            </DataTemplate>
           </GroupStyle.HeaderTemplate>
          </GroupStyle>
         </ListView.GroupStyle>
         <ListView.View>
          <GridView AllowsColumnReorder="False">
           <GridViewColumn Header="{DynamicResource M1.Status}" Width="50" DisplayMemberBinding="{Binding ReadState}" />
           <GridViewColumn Header="{DynamicResource M1.Thumbnail}" Width="65">
            <GridViewColumn.CellTemplate>
             <DataTemplate>
              <local:PhotoThumbnail Document="{Binding Document}" Height="42" Width="56" AutomationProperties.Name="{DynamicResource M1.Thumbnail}" />
             </DataTemplate>
            </GridViewColumn.CellTemplate>
           </GridViewColumn>
           <GridViewColumn x:Name="M1PhotoNameColumn" Header="{DynamicResource M1.Filename}" Width="240" DisplayMemberBinding="{Binding Name}" />
           <GridViewColumn Header="{DynamicResource M1.OriginalTags}" Width="64" DisplayMemberBinding="{Binding OriginalTagCount}" />
           <GridViewColumn Header="{DynamicResource M1.EditedTags}" Width="64" DisplayMemberBinding="{Binding DraftCount}" />
          </GridView>
         </ListView.View>
        </ListView>
        <TextBlock x:Name="M1PhotoEmpty" Text="{DynamicResource M1.EmptyImport}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="280" />
       </Grid>
      </DockPanel>
     </DockPanel>
     <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="{DynamicResource M1.Splitter}" />
     <DockPanel Grid.Column="2" Margin="10,3,10,0">
      <StackPanel DockPanel.Dock="Top">
       <DockPanel Margin="0,4">
        <Button DockPanel.Dock="Right" Content="{DynamicResource M1.Batch}" Tag="字段预设" Click="M1OpenTool" />
        <TextBlock Text="{DynamicResource M1.Metadata}" FontWeight="SemiBold" VerticalAlignment="Center" />
       </DockPanel>
       <TextBlock x:Name="SelectionInfo" TextWrapping="Wrap" Margin="0,0,0,3" />
       <TextBlock x:Name="InspectorCounts" TextWrapping="Wrap" FontSize="11" AutomationProperties.Name="{Binding Text,RelativeSource={RelativeSource Self}}" />
       <TextBlock x:Name="InspectorStatus" TextWrapping="Wrap" />
       <WrapPanel Margin="0,7,0,4" x:Name="M1InspectorModes">
        <RadioButton x:Name="M1CommonFields" Content="{DynamicResource M1.Common}" Tag="0" GroupName="InspectorMode" IsChecked="True" Style="{StaticResource M1.Navigation}" Checked="M1InspectorModeSelected" />
        <RadioButton x:Name="M1FullFields" Content="{DynamicResource M1.Full}" Tag="1" GroupName="InspectorMode" Style="{StaticResource M1.Navigation}" Checked="M1InspectorModeSelected" />
        <ComboBox x:Name="M1InspectorGroup" Width="110" SelectionChanged="M1InspectorGroupChanged" AutomationProperties.Name="{DynamicResource M1.Group}" />
        <Button Content="↻" ToolTip="{DynamicResource M1.Refresh}" Click="RereadPhotos" AutomationProperties.Name="{DynamicResource M1.Refresh}" />
       </WrapPanel>
       <ComboBox x:Name="InspectorView" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="InspectorViewChanged">
        <ComboBoxItem Content="常用字段" />
        <ComboBoxItem Content="完整字段" />
       </ComboBox>
       <Grid x:Name="M1FieldSearchBox">
        <TextBox x:Name="MetadataSearch" AutomationProperties.Name="{DynamicResource M1.FieldSearch}" ToolTip="{DynamicResource M1.FieldSearch}" TextChanged="MetadataFilterChanged" Margin="0,0,0,6" />
        <TextBlock Text="{DynamicResource M1.FieldSearch}" IsHitTestVisible="False" Opacity="0.55" Margin="9,0" VerticalAlignment="Center">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Visibility" Value="Collapsed" />
           <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=MetadataSearch,Path=Text}" Value="">
             <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </Grid>
      </StackPanel>
      <DockPanel DockPanel.Dock="Bottom" Margin="0,6">
       <Button x:Name="M1EditSelectedFields" DockPanel.Dock="Right" Content="{DynamicResource M1.EditSelected}" Click="EditInspectorField" />
       <TextBlock x:Name="M1FieldSelectionCount" VerticalAlignment="Center" />
      </DockPanel>
      <Grid>
       <TextBlock x:Name="M1InspectorEmpty" Text="{DynamicResource M1.EmptySelection}" HorizontalAlignment="Center" VerticalAlignment="Center" />
       <DataGrid x:Name="MetadataGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="None" GridLinesVisibility="Horizontal" BorderThickness="0" SelectionMode="Extended" SelectionChanged="M1FieldSelectionChanged" MouseDoubleClick="M1InspectorDoubleClick" PreviewKeyDown="M1InspectorKeyDown" CopyingRowClipboardContent="CopyMetadataRow" VirtualizingPanel.IsVirtualizingWhenGrouping="True" EnableRowVirtualization="True">
        <DataGrid.GroupStyle>
         <GroupStyle>
          <GroupStyle.HeaderTemplate>
           <DataTemplate>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,14,4,6" />
           </DataTemplate>
          </GroupStyle.HeaderTemplate>
         </GroupStyle>
        </DataGrid.GroupStyle>
        <DataGrid.RowStyle>
         <Style TargetType="DataGridRow">
          <Setter Property="ToolTip" Value="{Binding Tag}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Tag}" />
         </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
         <DataGridTemplateColumn Width="0.45*" MinWidth="140" ClipboardContentBinding="{Binding Tag}">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <StackPanel Margin="{DynamicResource M1.RowInset}">
             <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
             <TextBlock Text="{Binding SourceLabel}" FontSize="{DynamicResource M1.SourceFontSize}" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTemplateColumn Width="0.55*" MinWidth="100" ClipboardContentBinding="{Binding Value}">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <StackPanel Margin="{DynamicResource M1.RowInset}">
             <TextBlock Text="{Binding DisplayValue}" TextWrapping="Wrap" />
             <TextBlock Text="{Binding DisplayState}" Opacity="0.68" FontSize="{DynamicResource M1.SourceFontSize}" TextWrapping="Wrap" />
            </StackPanel>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTemplateColumn Width="40">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <Button Content="{Binding ActionLabel}" IsEnabled="{Binding CanEdit}" ToolTip="{Binding Permission}" AutomationProperties.Name="{Binding Permission}" Tag="{Binding}" Click="M1EditRow" Padding="5" />
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </DockPanel>
    </Grid>
   </TabItem>
   <TabItem Header="地图定位">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="170" />
     </Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <StackPanel DockPanel.Dock="Top" Margin="8,4">
        <DockPanel>
         <Button Content="搜索地点（Google联网）" Click="SearchPlace" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0" />
         <TextBox x:Name="MapSearchQuery" AutomationProperties.Name="地图搜索地点" MaxLength="256" KeyDown="MapSearchKeyDown" TextChanged="MapSearchQueryChanged" />
        </DockPanel>
        <ListBox x:Name="RecentMapSearches" AutomationProperties.Name="最近地图搜索" MaxHeight="90" Visibility="Collapsed" SelectionChanged="UseRecentMapSearch" />
       </StackPanel>
       <Expander Header="本机手填收藏（离线可用）" Margin="8,0" IsExpanded="True">
        <StackPanel>
         <TextBlock Text="名称/备注和WGS84坐标均由用户手填；服务返回文字不自动保存。点击收藏只预览。" />
         <WrapPanel>
          <ListBox x:Name="FavoriteList" Width="300" MaxHeight="100" SelectionChanged="PreviewFavorite" AutomationProperties.Name="本机手填收藏" />
          <CheckBox x:Name="FavoritesExpanded" Content="显示全部收藏" Checked="FavoritesExpand" Unchecked="FavoritesExpand" />
         </WrapPanel>
         <WrapPanel>
          <TextBlock Text="名称" />
          <TextBox x:Name="FavoriteName" Width="150" MaxLength="100" AutomationProperties.Name="收藏名称" />
          <TextBlock Text="备注" />
          <TextBox x:Name="FavoriteNote" Width="200" MaxLength="1000" AutomationProperties.Name="收藏手填备注" />
          <TextBlock Text="经度" />
          <TextBox x:Name="FavoriteLongitude" Width="95" MaxLength="32" AutomationProperties.Name="收藏WGS84经度" />
          <TextBlock Text="纬度" />
          <TextBox x:Name="FavoriteLatitude" Width="95" MaxLength="32" AutomationProperties.Name="收藏WGS84纬度" />
         </WrapPanel>
         <WrapPanel>
          <Button Content="新建手填收藏" Click="NewFavorite" />
          <Button Content="保存收藏编辑" Click="SaveFavorite" />
          <Button Content="删除当前收藏" Click="DeleteFavorite" />
          <Button Content="上移收藏" Click="MoveFavoriteUp" />
          <Button Content="重读收藏/地图偏好" Click="ReloadFavorites" />
         </WrapPanel>
         <TextBlock x:Name="FavoriteStatus" TextWrapping="Wrap" />
        </StackPanel>
       </Expander>
       <WrapPanel Margin="8,4">
        <CheckBox x:Name="MapSelectedOnly" Content="仅显示所选照片标记" Checked="MapDisplayChanged" Unchecked="MapDisplayChanged" />
        <CheckBox x:Name="MapStartWithDevice" IsChecked="True" Content="启动尝试系统定位，失败保留视野" Checked="MapDisplayChanged" Unchecked="MapDisplayChanged" />
        <TextBlock Text="Google图层" />
        <ComboBox x:Name="GoogleLayerChoice" Width="100" SelectedIndex="0" SelectionChanged="MapDisplayChanged" AutomationProperties.Name="Google地图图层">
         <ComboBoxItem Content="标准" />
         <ComboBoxItem Content="卫星" />
         <ComboBoxItem Content="混合" />
         <ComboBoxItem Content="地形" />
        </ComboBox>
        <Button Content="尝试系统定位" Click="LocateDevice" />
        <TextBlock Text="OpenFreeMap仅标准底图；定位失败保留视野。Google视野仅会话，不缓存查询内容。" />
       </WrapPanel>
       <WrapPanel DockPanel.Dock="Top" Margin="8">
        <Button x:Name="TrackReadButton" Content="导入轨迹" Click="ReadTracks" Padding="12,6" />
        <ComboBox x:Name="TrackList" Width="250" Margin="8,0" DisplayMemberPath="Name" SelectionChanged="TrackSelected" AutomationProperties.Name="当前轨迹" />
        <Button x:Name="TrackRemoveButton" Content="移除当前轨迹" Click="RemoveTrack" Padding="12,6" />
        <Button x:Name="MapRetryButton" Content="重载地图" Click="RetryMap" Padding="12,6" Margin="8,0,0,0" />
       </WrapPanel>
       <Expander Header="多轨迹独立显隐（不改变匹配集合）" Margin="8,0">
