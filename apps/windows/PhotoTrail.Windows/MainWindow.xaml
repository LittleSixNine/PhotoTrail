     <CheckBox x:Name="RecordMapSearches" Content="记录最近搜索" IsChecked="True" Checked="MetadataSettingChanged" Unchecked="MetadataSettingChanged" Margin="0,10,0,6"/>
     <Button x:Name="ClearSearchHistoryButton" Content="清除最近搜索记录" Click="ClearSearchHistory" HorizontalAlignment="Left" Padding="10,5"/>
     <TextBlock x:Name="SearchHistoryStatus" Text="默认最多记录3条；关闭隐藏并停止新增，重新开启恢复。清除只删除历史内容。" TextWrapping="Wrap" Margin="0,6,0,12"/>
     <Button x:Name="EnvironmentCheckButton" Content="检查本机环境" Click="CheckDependencies" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,8"/>
     <TextBlock x:Name="DependencyStatus" Text="可检查.NET、WebView2与ExifTool；只读取本机环境。" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <TextBlock Text="Google Maps 自备密钥" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="默认地图仍为免费的OpenFreeMap，无需密钥。保存密钥后可明确选择Google地图；仅当前会话使用，重启默认回到OpenFreeMap。" TextWrapping="Wrap" Margin="0,10,0,10"/>
     <TextBlock Text="使用Google服务需自行配置项目、相应API及计费，并设置密钥限制与配额；保存密钥不代表验证成功，也不会产生Google请求。" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <Label Content="Google API密钥" Target="{Binding ElementName=GoogleKeyInput}"/>
     <PasswordBox x:Name="GoogleKeyInput" AutomationProperties.Name="Google API密钥" MaxLength="256" Width="420" HorizontalAlignment="Left"/>
     <WrapPanel Margin="0,12,0,12"><Button Content="保存本机密钥" Click="SaveGoogleKey" Padding="12,6"/><Button Content="删除本机密钥" Click="ClearGoogleKey" Padding="12,6" Margin="8,0,0,0"/></WrapPanel>
     <WrapPanel Margin="0,0,0,12"><Button Content="使用Google地图（联网）" Click="UseGoogleMap" Padding="12,6"/><Button Content="使用默认地图" Click="UseDefaultMap" Padding="12,6" Margin="8,0,0,0"/></WrapPanel>
     <TextBlock Text="Google使用时密钥会交给网页SDK并随请求发送，DPAPI仅保护本机存储。HTTP来源限制应匹配https://phototrail.local/*；启用Maps JavaScript API与Geocoding API。地区结果当前只预览，不自动保存。" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock x:Name="GoogleKeyStatus" Text="尚未保存本机密钥。" TextWrapping="Wrap"/>
     <TextBlock Text="密钥以Windows当前用户保护的数据保存；不会回显、进入项目源码或开发日志。更换电脑/用户后请重新输入。同一Windows用户运行的程序仍可能访问它；它不能替代Google的密钥限制。" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="重命名">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="沿用元数据页所选照片；规则从上到下读取前步结果；简单规则默认作用于主体。每行一条：前缀|旅行_、后缀|_成片、替换|旧|新、设名|新名称、大写、小写、序号|起始|步长|位数。参数规则每行一个Windows JSON对象；可选完整名称与扩展名域。" TextWrapping="Wrap"/>
     <StackPanel Grid.Row="1">
      <WrapPanel><ComboBox x:Name="RenameSchemeList" Width="220" SelectionChanged="RenameSchemeChanged" AutomationProperties.Name="已保存重命名方案"/><TextBlock x:Name="RenameSchemeStatus" Text="方案库尚未读取" Margin="8,0" VerticalAlignment="Center"/></WrapPanel>
      <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Expander x:Name="RenameSchemeManager" Header="方案管理 · 保存配置不会执行改名"><StackPanel>
       <WrapPanel><TextBlock Text="名称"/><TextBox x:Name="RenameSchemeName" Width="220" MaxLength="100" TextChanged="SchemeTextChanged" AutomationProperties.Name="重命名方案名称"/><TextBlock Text="文件名示例（独立于规则）" Margin="8,0"/><TextBox x:Name="RenameSchemeExample" Width="260" MaxLength="255" TextChanged="SchemeTextChanged" AutomationProperties.Name="重命名方案示例"/></WrapPanel>
       <WrapPanel x:Name="RenameSchemeActions"><Button Content="新建" Click="NewRenameScheme"/><Button Content="更新当前／保存新方案" Click="UpdateRenameScheme"/><Button Content="另存为" Click="SaveAsRenameScheme"/><Button Content="改名" Click="RenameCurrentScheme"/><Button Content="删除当前" Click="DeleteRenameScheme"/><Button Content="导入JSON…" Click="LoadRenamePreset"/><Button Content="导出JSON…" Click="SaveRenamePreset"/></WrapPanel>
      </StackPanel></Expander>
      <Expander Header="处理排序与输入筛选" IsExpanded="True"><StackPanel x:Name="RenameProcessingControls"><WrapPanel><ComboBox x:Name="RenameProcessingSort" Width="130" SelectedIndex="0" SelectionChanged="RenameOrderChanged" AutomationProperties.Name="重命名处理排序"><ComboBoxItem Content="导入顺序"/><ComboBoxItem Content="文件名"/><ComboBoxItem Content="自然文件名"/><ComboBoxItem Content="拍摄时间"/><ComboBoxItem Content="创建时间"/><ComboBoxItem Content="修改时间"/><ComboBoxItem Content="扩展名"/><ComboBoxItem Content="目录"/><ComboBoxItem Content="大小"/><ComboBoxItem Content="设备品牌"/><ComboBoxItem Content="设备型号"/><ComboBoxItem Content="城市"/><ComboBoxItem Content="评分"/><ComboBoxItem Content="通用元数据"/><ComboBoxItem Content="手动顺序"/></ComboBox><CheckBox x:Name="RenameDescending" Content="降序（缺值最后）" Checked="RenameOrderChanged" Unchecked="RenameOrderChanged"/><TextBlock Text="排序标签"/><TextBox x:Name="RenameMetadataTag" Width="150" MaxLength="256" TextChanged="RenameOrderChanged" AutomationProperties.Name="元数据排序标签"/><Button Content="读取配对并刷新预览" Click="RefreshRenameOrder"/></WrapPanel><WrapPanel><TextBlock Text="文件名／路径"/><TextBox x:Name="RenameInputQuery" Width="100" MaxLength="256" TextChanged="RenameOrderChanged" AutomationProperties.Name="输入筛选文件名／路径"/><TextBlock Text="类型"/><TextBox x:Name="RenameInputType" Width="100" MaxLength="256" TextChanged="RenameOrderChanged" AutomationProperties.Name="输入筛选类型"/><TextBlock Text="目录"/><TextBox x:Name="RenameInputFolder" Width="100" MaxLength="256" TextChanged="RenameOrderChanged" AutomationProperties.Name="输入筛选目录"/><TextBlock Text="设备"/><TextBox x:Name="RenameInputCamera" Width="100" MaxLength="256" TextChanged="RenameOrderChanged" AutomationProperties.Name="输入筛选设备"/><TextBlock Text="日期开始"/><TextBox x:Name="RenameDateFrom" Width="100" MaxLength="256" TextChanged="RenameOrderChanged" AutomationProperties.Name="输入筛选日期开始"/><TextBlock Text="日期结束"/><TextBox x:Name="RenameDateTo" Width="100" MaxLength="256" TextChanged="RenameOrderChanged" AutomationProperties.Name="输入筛选日期结束"/><TextBlock Text="标签"/><TextBox x:Name="RenameInputTag" Width="100" MaxLength="256" TextChanged="RenameOrderChanged" AutomationProperties.Name="输入筛选标签"/><ComboBox x:Name="RenameInputGps" Width="85" SelectedIndex="0" SelectionChanged="RenameOrderChanged"><ComboBoxItem Content="全部GPS"/><ComboBoxItem Content="有GPS"/><ComboBoxItem Content="无GPS"/></ComboBox><ComboBox x:Name="RenameInputPresence" Width="85" SelectedIndex="0" SelectionChanged="RenameOrderChanged"><ComboBoxItem Content="全部标签"/><ComboBoxItem Content="标签存在"/><ComboBoxItem Content="标签缺失"/></ComboBox></WrapPanel><TextBlock Text="日期用完整时间或日期（仅日期=午夜）；输入成员命中则整组参与。"/></StackPanel></Expander><TextBlock x:Name="RenameOrderStatus" Text="尚未读取配对组。"/><DockPanel  Margin="0,10,0,10"><Button x:Name="FreezeRenameButton" DockPanel.Dock="Right" Content="检查冲突并冻结" Click="FreezeRename" Padding="12,6" Margin="10,0,0,0"/><TextBox x:Name="RenameRules" AutomationProperties.Name="重命名规则链" Text="前缀|旅行_" TextChanged="RenameRulesChanged" AcceptsReturn="True" MaxLength="32768" Height="60" VerticalScrollBarVisibility="Auto"/></DockPanel>
     <WrapPanel><TextBlock Text="结果查看"/><ComboBox x:Name="RenameViewOrder" Width="110" SelectedIndex="0" SelectionChanged="RenameViewChanged"><ComboBoxItem Content="处理顺序"/><ComboBoxItem Content="新名升序"/><ComboBoxItem Content="新名降序"/></ComboBox><ComboBox x:Name="RenameViewFilter" Width="95" SelectedIndex="0" SelectionChanged="RenameViewChanged"><ComboBoxItem Content="查看全部"/><ComboBoxItem Content="只看变化"/><ComboBoxItem Content="只看不变"/></ComboBox><Button Content="上移 Alt+↑" Click="RenameMoveUp"/><Button Content="下移 Alt+↓" Click="RenameMoveDown"/><Button x:Name="RenameUndoOrder" Content="撤销 Ctrl+Z" Click="UndoRenameOrder"/><TextBox x:Name="RenameInsertPosition" Width="30" Text="1" AutomationProperties.Name="可见组插入位置"/><Button Content="插入此位置" Click="InsertRenameGroups"/></WrapPanel><TextBlock x:Name="RenameDropHint" Text="拖到目标组前，空白为末尾；仅改内存。"/></StackPanel></ScrollViewer></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="RenameGroups" SelectionMode="Extended" DisplayMemberPath="Name" AllowDrop="True" PreviewMouseLeftButtonDown="RenameDragBegin" PreviewMouseMove="RenameDragMove" DragOver="RenameDragOver" Drop="RenameDrop" PreviewKeyDown="RenameOrderKey" AutomationProperties.Name="处理组顺序（可多选拖放）"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="ToolTip" Value="{Binding Status}"/></Style></ListBox.ItemContainerStyle></ListBox><DataGrid x:Name="RenamePreview" Grid.Column="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="原名" Binding="{Binding OriginalName}" Width="*"/><DataGridTextColumn Header="新名" Binding="{Binding NewName}" Width="*"/><DataGridTextColumn Header="中间步骤（主文件规则结果）" Binding="{Binding Steps}" Width="250"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="200"/></DataGrid.Columns></DataGrid></Grid>
     <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <WrapPanel><Button x:Name="RenamePresetSaveButton" Content="导出方案…" Click="SaveRenamePreset" Padding="10,6" Margin="0,0,8,0"/><Button x:Name="RenamePresetLoadButton" Content="导入方案／旧规则…" Click="LoadRenamePreset" Padding="10,6" Margin="0,0,12,0"/><Button x:Name="ExecuteRenameButton" Content="执行冻结计划" Click="ExecuteRename" IsEnabled="False" Padding="12,6" Margin="10,0,0,0"/></WrapPanel>
      <TextBlock Text="执行记录路径（恢复会验证实际文件内容，不覆盖其他文件）" Margin="0,8,0,4"/>
      <DockPanel><Button x:Name="RestoreRenameButton" DockPanel.Dock="Right" Content="按记录恢复原名" Click="RestoreRename" Padding="12,6" Margin="8,0,0,0"/><TextBox x:Name="RenameJournalPath" AutomationProperties.Name="重命名执行记录" MaxLength="32768"/></DockPanel>
      <TextBlock x:Name="RenameStatus" Text="预览不修改文件；冻结后才可执行，成功/失败/取消均保留实际名称记录。" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="CSV">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="CSV · 沿用元数据页当前选择" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="回导CSV的值使用JSON字符串或列表；空单元不修改，@clear明确清除。只匹配当前选择的身份与相对路径，跨电脑路径改变后不能直接匹配。" TextWrapping="Wrap" Margin="0,8"/>
      <WrapPanel><Button Content="导出回导CSV…" Click="ExportRoundtripCsv" Padding="10,6"/><Button Content="导出显示CSV…" Click="ExportDisplayCsv" Padding="10,6" Margin="8,0"/></WrapPanel>
      <TextBlock Text="导入文件" Margin="0,12,0,4"/>
      <DockPanel><Button Content="选择…" DockPanel.Dock="Right" Click="ChooseCsv" Padding="10,5" Margin="8,0,0,0"/><TextBox x:Name="CsvPath" AutomationProperties.Name="CSV导入文件" TextChanged="CsvChanged"/></DockPanel>
      <WrapPanel Margin="0,8"><Button x:Name="CsvApplyButton" Content="应用" Click="ApplyCsv" IsEnabled="False" Padding="10,6" Margin="8,0"/></WrapPanel>
      <TextBlock Text="应用只加入待保存草稿，可撤销；保存副本才写入文件，不覆盖已有文件。显示CSV有公式防护，不能回导；Google查询结果不导出。" TextWrapping="Wrap" Margin="0,0,0,8"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="CsvPreview" Text="设置参数后应用；只加入待保存草稿。" TextWrapping="Wrap"/></ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem Header="应用设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="外观" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="默认跟随Windows系统；更改后保存本机外观偏好，重启恢复。" TextWrapping="Wrap" Margin="0,8"/>
     <ComboBox x:Name="ThemeChoice" Width="220" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="ThemeChanged" AutomationProperties.Name="应用外观"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
     <TextBlock x:Name="ThemeStatus" Text="默认跟随Windows系统外观；不改变系统设置。" TextWrapping="Wrap" Margin="0,8"/>
     <TextBlock Text="常用字段配置" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/>
     <TextBox x:Name="CommonFieldSearch" AutomationProperties.Name="搜索常用字段名称或技术标签" TextChanged="CommonFieldSearchChanged"/>
     <WrapPanel><Button Content="恢复默认24项" Click="RestoreCommonFields" Padding="8,4"/><Button Content="清空常用字段" Click="ClearCommonFields" Padding="8,4"/></WrapPanel>
     <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CommonFieldOptions"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" Tag="{Binding Tag}" IsChecked="{Binding Selected,Mode=OneWay}" Checked="CommonFieldToggled" Unchecked="CommonFieldToggled" AutomationProperties.Name="{Binding Label}" Margin="2,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <TextBlock Text="元数据显示" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/>
     <Label Content="文字大小" Target="{Binding ElementName=MetadataTextSize}"/><ComboBox x:Name="MetadataTextSize" Width="220" HorizontalAlignment="Left" SelectedIndex="1" AutomationProperties.Name="元数据文字大小" SelectionChanged="MetadataSettingChanged"><ComboBoxItem Content="小（-2 pt）"/><ComboBoxItem Content="标准"/><ComboBoxItem Content="大（+2 pt）"/></ComboBox>
     <Label Content="行间距" Target="{Binding ElementName=MetadataSpacing}"/><ComboBox x:Name="MetadataSpacing" Width="220" HorizontalAlignment="Left" SelectedIndex="1" AutomationProperties.Name="元数据行间距" SelectionChanged="MetadataSettingChanged"><ComboBoxItem Content="紧凑"/><ComboBoxItem Content="标准"/><ComboBoxItem Content="宽松"/></ComboBox>
     <CheckBox x:Name="FullTagNames" Content="显示完整标签名称" IsChecked="True" Checked="MetadataSettingChanged" Unchecked="MetadataSettingChanged" Margin="0,12,0,8"/>
     <TextBlock Text="关闭后保留来源家族；完整名称继续用于提示、辅助技术、搜索与复制。" TextWrapping="Wrap"/>
     <Button Content="恢复显示、排序与搜索开关默认值" Click="ResetSettings" HorizontalAlignment="Left" Padding="12,6" Margin="0,14,0,8"/>
     <TextBlock x:Name="SettingsStatus" Text="文字大小和行间距独立；默认标准，即时生效并保存本机。" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
