        </StackPanel>
       </Expander>
       <Expander x:Name="PhotoGpxPanel" Header="从所选照片生成GPX（不保存照片）" Margin="8,0">
        <StackPanel x:Name="PhotoGpxControls">
         <TextBlock Text="冻结当前有效GPS与主时间（含已确认草稿）；无明确WGS84/偏移、非法或无法无损适配的时间分别跳过，不回退旧时间，不删重复点。" TextWrapping="Wrap" />
         <WrapPanel>
          <TextBlock Text="断段间隔秒（严格大于）" />
          <TextBox x:Name="GpxSegmentGap" Text="300" Width="110" MaxLength="32" TextChanged="PhotoGpxInputChanged" AutomationProperties.Name="照片GPX断段间隔秒" />
          <TextBlock Text="轨迹名称" />
          <TextBox x:Name="PhotoGpxName" Text="PhotoTrail Photos" Width="200" MaxLength="255" TextChanged="PhotoGpxInputChanged" AutomationProperties.Name="照片GPX名称" />
          <Button Content="冻结所选照片生成预览" Click="PreviewPhotoGpx" />
         </WrapPanel>
